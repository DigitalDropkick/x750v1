#!/bin/sh

set -eu
umask 077

job_id="${1:-}"
task="${2:-}"
job_root="/tmp/ddk/jobs"
report_root="/tmp/ddk/reports"

job_numbers="${job_id#job-}"
job_epoch="${job_numbers%%-*}"
job_pid="${job_numbers#*-}"
[ "$job_numbers" != "$job_id" ] || exit 64
[ "$job_epoch" != "$job_numbers" ] || exit 64
case "$job_epoch" in ''|*[!0-9]*) exit 64 ;; esac
case "$job_pid" in ''|*[!0-9]*) exit 64 ;; esac
case "$task" in
	demo|system_report|nmap_lan_discovery|cellular_snapshot|tcpdump_lan_metadata) ;;
	*) exit 64 ;;
esac

job_dir="$job_root/$job_id"
[ -d "$job_dir" ] || exit 66
[ -f "$job_dir/metadata.json" ] || exit 66

status_set() {
	status_value="$1"
	printf '%s\n' "$status_value" > "$job_dir/status.next"
	mv "$job_dir/status.next" "$job_dir/status"
}

child_pid=""

stop_job() {
	# Invoked asynchronously by the signal trap.
	# shellcheck disable=SC2317
	trap - HUP INT TERM
	# shellcheck disable=SC2317
	if [ -n "$child_pid" ]; then
		case "$child_pid" in
			*[!0-9]*) ;;
			*)
				kill -TERM "$child_pid" 2>/dev/null || true
				sleep 1
				kill -KILL "$child_pid" 2>/dev/null || true
				wait "$child_pid" 2>/dev/null || true
				;;
		esac
		fi
		# shellcheck disable=SC2317
		rm -f "$job_dir"/cellular-*.json "$job_dir"/cellular-*.json.err "$job_dir"/tcpdump.stderr
		# shellcheck disable=SC2317
		status_set stopped
	# shellcheck disable=SC2317
	printf '%s\n' 'Worker stopped by an authenticated DDK request.' >> "$job_dir/stderr"
	# shellcheck disable=SC2317
	exit 143
}

task_fail() {
	printf '%s\n' "$1" >> "$job_dir/stderr"
	status_set failed
	exit 65
}

validate_ipv4() {
	address_value="$1"
	previous_ifs="$IFS"
	IFS=.
	# Intentionally split only the already server-derived address.
	# shellcheck disable=SC2086
	set -- $address_value
	IFS="$previous_ifs"
	[ "$#" -eq 4 ] || return 1
	for octet_value in "$@"; do
		case "$octet_value" in
			''|*[!0-9]*) return 1 ;;
		esac
		[ "$octet_value" -le 255 ] 2>/dev/null || return 1
	done
	return 0
}

validate_private_ipv4() {
	private_value="$1"
	case "$private_value" in
		10.*|192.168.*) return 0 ;;
		172.*)
			second_octet="${private_value#*.}"
			second_octet="${second_octet%%.*}"
			[ "$second_octet" -ge 16 ] 2>/dev/null && [ "$second_octet" -le 31 ] 2>/dev/null
			return $?
			;;
	esac
	return 1
}

safe_word() {
	case "$1" in
		''|*[!A-Za-z0-9_.-]*) printf '%s' UNKNOWN ;;
		*) printf '%s' "$1" ;;
	esac
}

safe_number() {
	case "$1" in
		''|*[!0-9.-]*) printf '%s' UNKNOWN ;;
		*) printf '%s' "$1" ;;
	esac
}

run_uqmi_query() {
	query_label="$1"
	query_action="$2"
	query_output="$3"
	query_error="$query_output.err"
	: > "$query_output"
	: > "$query_error"

	/sbin/uqmi -d /dev/cdc-wdm0 --timeout 5000 "$query_action" > "$query_output" 2> "$query_error" &
	child_pid=$!
	query_deadline=$(( $(date +%s) + 7 ))
	query_timed_out=0
	while kill -0 "$child_pid" 2>/dev/null; do
		if [ "$(date +%s)" -ge "$query_deadline" ]; then
			query_timed_out=1
			kill -TERM "$child_pid" 2>/dev/null || true
			sleep 1
			kill -KILL "$child_pid" 2>/dev/null || true
			break
		fi
		sleep 1
	done
	query_result=0
	wait "$child_pid" 2>/dev/null || query_result=$?
	child_pid=""
	if [ -s "$query_error" ]; then
		{
			printf '%s: ' "$query_label"
			head -c 4096 "$query_error"
			printf '\n'
		} >> "$job_dir/stderr"
	fi
	rm -f "$query_error"
	if [ "$query_timed_out" -eq 1 ]; then
		printf '%s timed out after 7 seconds.\n' "$query_label" >> "$job_dir/stderr"
		return 124
	fi
	return "$query_result"
}

trap stop_job HUP INT TERM
printf '%s\n' "$$" > "$job_dir/pid"
: > "$job_dir/stdout"
: > "$job_dir/stderr"
status_set running

result=0

if [ "$task" = "demo" ]; then
	demo_tmp="$job_dir/stdout.next"
	{
		printf '%s\n' 'DIGITAL DROPKICK ASYNCHRONOUS READ-ONLY PROOF'
		printf 'Started (UTC): '
		date -u
		printf '%s\n' 'The worker is detached from the LuCI request.'
		sleep 2
		printf '\nKernel: '
		uname -r
		printf 'Uptime: '
		cut -d ' ' -f 1 /proc/uptime
		printf 'Interfaces: '
		ip -o link show | wc -l
		printf 'Installed packages: '
		opkg list-installed | wc -l
		printf 'Completed (UTC): '
		date -u
	} > "$demo_tmp" 2> "$job_dir/stderr" || result=$?
	head -c 131072 "$demo_tmp" > "$job_dir/stdout"
	rm -f "$demo_tmp"
elif [ "$task" = "system_report" ]; then
	report_id="report-${job_id#job-}"
	report_tmp="$report_root/$report_id.txt.next"
	report_path="$report_root/$report_id.txt"
	mkdir -p "$report_root"
	chmod 700 /tmp/ddk "$report_root" 2>/dev/null || true
	{
		printf '%s\n' 'DIGITAL DROPKICK FIELD CONSOLE — SYSTEM REPORT'
		printf '%s\n' 'Read-only and sanitized: no configuration bodies, credentials, keys, tokens, or peer lists.'
		printf 'Generated (UTC): '
		date -u
		printf '\n[IDENTITY]\n'
		ubus call system board
		uname -a
		printf '\n[UPTIME AND LOAD]\n'
		cat /proc/uptime
		cat /proc/loadavg
		printf '\n[MEMORY AND SWAP]\n'
		free
		cat /proc/swaps
		printf '\n[STORAGE]\n'
		df -hT
		mount
		printf '\n[NETWORK INTERFACES AND ROUTES]\n'
		ip -o link show
		ip -o addr show
		ip route show
		printf '\n[DNS SERVERS]\n'
		awk '/^nameserver/{print}' /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null || true
		printf '\n[TAILSCALE SELF]\n'
		if command -v tailscale >/dev/null 2>&1; then
			tailscale version
			tailscale ip -4
			if pidof tailscaled >/dev/null 2>&1; then printf '%s\n' 'tailscaled: running'; else printf '%s\n' 'tailscaled: not running'; fi
		else
			printf '%s\n' 'tailscale: not installed'
		fi
		printf '\n[USB AND DEVICE NODES]\n'
		if command -v lsusb >/dev/null 2>&1; then lsusb; fi
		ls -l /dev/ttyUSB* /dev/ttyACM* /dev/video* /dev/i2c-* /dev/spidev* 2>/dev/null || true
		ip -details link show type can 2>/dev/null || true
		printf '\n[INSTALLED PACKAGE COUNT]\n'
		opkg list-installed | wc -l
		printf '\n[INSTALLED PACKAGE NAMES]\n'
		opkg list-installed | awk '{print $1}' | sort
		printf '\n[PROTECTED CONFIGURATION HASHES — CONTENTS NOT INCLUDED]\n'
		sha256sum /etc/config/network /etc/config/firewall /etc/config/wireless /etc/config/uhttpd /etc/config/rpcd 2>/dev/null || true
	} > "$report_tmp" 2> "$job_dir/stderr" || result=$?
	head -c 131072 "$report_tmp" > "$report_path"
	rm -f "$report_tmp"
	chmod 600 "$report_path"
	printf 'Report ready: %s\n' "$report_id" > "$job_dir/stdout"
elif [ "$task" = "nmap_lan_discovery" ]; then
	command -v nmap >/dev/null 2>&1 || task_fail 'Nmap is not installed; the console did not attempt installation.'
	command -v jsonfilter >/dev/null 2>&1 || task_fail 'The native jsonfilter helper is unavailable.'

	lan_status="$(ubus call network.interface.lan status 2>/dev/null)" || task_fail 'Unable to read the native LAN status.'
	lan_device="$(jsonfilter -s "$lan_status" -e '@.l3_device' 2>/dev/null)" || task_fail 'Unable to derive the LAN device.'
	[ "$lan_device" = "br-lan" ] || task_fail 'Safety policy rejected discovery because the native LAN device is not br-lan.'
	lan_cidr="$(ip -o -4 addr show dev br-lan scope global 2>/dev/null | awk '$3 == "inet" { print $4; exit }')"
	case "$lan_cidr" in
		*/*) ;;
		*) task_fail 'Safety policy could not derive an IPv4 CIDR from br-lan.' ;;
	esac
	case "$lan_cidr" in
		*/*/*|*[!0-9./]*) task_fail 'Safety policy rejected the derived LAN CIDR format.' ;;
	esac
	lan_ip="${lan_cidr%/*}"
	lan_prefix="${lan_cidr#*/}"
	validate_ipv4 "$lan_ip" || task_fail 'Safety policy rejected the derived LAN IPv4 address.'
	validate_private_ipv4 "$lan_ip" || task_fail 'Safety policy permits only an RFC1918 private LAN target.'
	case "$lan_prefix" in
		''|*[!0-9]*) task_fail 'Safety policy rejected the derived LAN prefix.' ;;
	esac
	if ! { [ "$lan_prefix" -ge 24 ] 2>/dev/null && [ "$lan_prefix" -le 32 ] 2>/dev/null; }; then
		task_fail 'Safety policy permits only a private /24 or smaller br-lan subnet.'
	fi

	{
		printf '%s\n' 'DIGITAL DROPKICK — BOUNDED NMAP LAN HOST DISCOVERY'
		printf '%s\n' 'Scope source: network.interface.lan / br-lan (server-derived)'
		printf 'Target: %s\n' "$lan_cidr"
		printf '%s\n' 'Profile: host discovery only (-sn), no DNS (-n), no port scan'
		printf '%s\n' 'Limits: /24 maximum, T3, 1 retry, 8s host timeout, 64 packets/second, 75s wall time'
		printf 'Started (UTC): '
		date -u
		printf '\n'
	} > "$job_dir/stdout"

	/usr/bin/nmap -sn -n -T3 --max-retries 1 --host-timeout 8s --max-rate 64 -e br-lan "$lan_cidr" \
		>> "$job_dir/stdout" 2> "$job_dir/stderr" &
	child_pid=$!
	deadline_epoch=$(( $(date +%s) + 75 ))
	timed_out=0
	while kill -0 "$child_pid" 2>/dev/null; do
		if [ "$(date +%s)" -ge "$deadline_epoch" ]; then
			timed_out=1
			kill -TERM "$child_pid" 2>/dev/null || true
			sleep 2
			kill -KILL "$child_pid" 2>/dev/null || true
			break
		fi
		sleep 1
	done
	child_result=0
	wait "$child_pid" 2>/dev/null || child_result=$?
	child_pid=""
	if [ "$timed_out" -eq 1 ]; then
		result=124
		printf '%s\n' 'Nmap discovery exceeded the fixed 75-second wall limit.' >> "$job_dir/stderr"
	else
		result="$child_result"
	fi
	printf '\nCompleted (UTC): ' >> "$job_dir/stdout"
	date -u >> "$job_dir/stdout"
	head -c 131072 "$job_dir/stdout" > "$job_dir/stdout.next"
	mv "$job_dir/stdout.next" "$job_dir/stdout"
elif [ "$task" = "tcpdump_lan_metadata" ]; then
	[ -x /usr/sbin/tcpdump ] || task_fail 'Tcpdump is not installed at the reviewed path; the console did not attempt installation.'
	command -v jsonfilter >/dev/null 2>&1 || task_fail 'The native jsonfilter helper is unavailable.'

	lan_status="$(ubus call network.interface.lan status 2>/dev/null)" || task_fail 'Unable to read the native LAN status.'
	lan_up="$(jsonfilter -s "$lan_status" -e '@.up' 2>/dev/null)" || task_fail 'Unable to derive the LAN state.'
	lan_device="$(jsonfilter -s "$lan_status" -e '@.l3_device' 2>/dev/null)" || task_fail 'Unable to derive the LAN device.'
	[ "$lan_up" = "true" ] || task_fail 'Safety policy rejected capture because the native LAN is not up.'
	[ "$lan_device" = "br-lan" ] || task_fail 'Safety policy rejected capture because the native LAN device is not br-lan.'
	[ -r /sys/class/net/br-lan/flags ] || task_fail 'Safety policy cannot read the br-lan interface flags.'
	flags_before="$(cat /sys/class/net/br-lan/flags)"
	capture_error="$job_dir/tcpdump.stderr"

	{
		printf '%s\n' 'DIGITAL DROPKICK — BOUNDED LAN METADATA SNAPSHOT'
		printf '%s\n' 'Scope source: network.interface.lan / br-lan (server-derived)'
		printf '%s\n' 'Profile: ARP, ICMP, and IPv4 DHCP metadata only; decoded text, no PCAP file'
		printf '%s\n' 'Privacy: transient timestamps, MAC addresses, and IP addresses may appear'
		printf '%s\n' 'Safety: non-promiscuous (-p), no DNS (-n), quiet decode (-q), no payload dump'
		printf '%s\n' 'Limits: 20-second window, 128 packets, 96-byte snap length, 64 KiB text output'
		printf 'Started (UTC): '
		date -u
		printf '\n[CAPTURE]\n'
	} > "$job_dir/stdout"

	/usr/sbin/tcpdump -i br-lan -p -n -q -e -l -tttt -s 96 -c 128 \
		'arp or icmp or (ip and udp and (port 67 or port 68))' \
		>> "$job_dir/stdout" 2> "$capture_error" &
	child_pid=$!
	deadline_epoch=$(( $(date +%s) + 20 ))
	window_ended=0
	while kill -0 "$child_pid" 2>/dev/null; do
		if [ "$(date +%s)" -ge "$deadline_epoch" ]; then
			window_ended=1
			kill -TERM "$child_pid" 2>/dev/null || true
			sleep 1
			if kill -0 "$child_pid" 2>/dev/null; then
				kill -KILL "$child_pid" 2>/dev/null || true
			fi
			break
		fi
		sleep 1
	done
	child_result=0
	wait "$child_pid" 2>/dev/null || child_result=$?
	child_pid=""
	flags_after="$(cat /sys/class/net/br-lan/flags)"
	if [ "$flags_before" != "$flags_after" ]; then
		rm -f "$capture_error"
		task_fail 'Safety policy detected a br-lan interface-flag change during capture.'
	fi

	captured_packets="$(awk '$2 == "packets" && $3 == "captured" {print $1; exit}' "$capture_error" 2>/dev/null || true)"
	case "$captured_packets" in ''|*[!0-9]*) captured_packets=UNKNOWN ;; esac
	if [ "$window_ended" -eq 0 ] && [ "$child_result" -ne 0 ]; then
		head -c 4096 "$capture_error" >> "$job_dir/stderr"
		result="$child_result"
	else
		{
			printf '\n[CAPTURE COMPLETE]\n'
			printf 'Stop condition: %s\n' "$(if [ "$window_ended" -eq 1 ]; then printf '%s' 'fixed 20-second window'; else printf '%s' '128-packet ceiling'; fi)"
			printf 'Packets captured: %s\n' "$captured_packets"
			printf 'Interface flags: %s before / %s after\n' "$flags_before" "$flags_after"
			printf 'Completed (UTC): '
			date -u
		} >> "$job_dir/stdout"
	fi
	rm -f "$capture_error"
	head -c 65536 "$job_dir/stdout" > "$job_dir/stdout.next"
	mv "$job_dir/stdout.next" "$job_dir/stdout"
else
	command -v uqmi >/dev/null 2>&1 || task_fail 'UQMI is not installed; the console did not attempt installation.'
	command -v jsonfilter >/dev/null 2>&1 || task_fail 'The native jsonfilter helper is unavailable.'
	[ -c /dev/cdc-wdm0 ] || task_fail 'The expected QMI management device /dev/cdc-wdm0 is unavailable.'
	modem_sysfs=/sys/class/usbmisc/cdc-wdm0/device
	[ -d "$modem_sysfs" ] || task_fail 'The QMI management sysfs path is unavailable.'
	[ "$(cat "$modem_sysfs/../idVendor" 2>/dev/null)" = '2c7c' ] || task_fail 'Safety policy rejected the unexpected modem USB vendor.'
	[ "$(cat "$modem_sysfs/../idProduct" 2>/dev/null)" = '0125' ] || task_fail 'Safety policy rejected the unexpected modem USB product.'
	[ "$(basename "$(readlink -f "$modem_sysfs/driver")")" = 'qmi_wwan' ] || task_fail 'Safety policy rejected the unexpected modem driver.'
	[ -d "$modem_sysfs/net/wwan0" ] || task_fail 'Safety policy could not attribute wwan0 to the expected QMI device.'

	mode_file="$job_dir/cellular-mode.json"
	data_file="$job_dir/cellular-data.json"
	signal_file="$job_dir/cellular-signal.json"
	serving_file="$job_dir/cellular-serving.json"
	query_success=0
	if run_uqmi_query OPERATING_MODE --get-device-operating-mode "$mode_file"; then query_success=$((query_success + 1)); fi
	if run_uqmi_query DATA_STATUS --get-data-status "$data_file"; then query_success=$((query_success + 1)); fi
	if run_uqmi_query SIGNAL_INFO --get-signal-info "$signal_file"; then query_success=$((query_success + 1)); fi
	if run_uqmi_query SERVING_SYSTEM --get-serving-system "$serving_file"; then query_success=$((query_success + 1)); fi

	mode="$(jsonfilter -i "$mode_file" -e '@' 2>/dev/null || true)"
	data_status="$(jsonfilter -i "$data_file" -e '@' 2>/dev/null || true)"
	radio_type="$(jsonfilter -i "$signal_file" -e '@.type' 2>/dev/null || true)"
	rssi="$(jsonfilter -i "$signal_file" -e '@.rssi' 2>/dev/null || true)"
	rsrq="$(jsonfilter -i "$signal_file" -e '@.rsrq' 2>/dev/null || true)"
	rsrp="$(jsonfilter -i "$signal_file" -e '@.rsrp' 2>/dev/null || true)"
	snr="$(jsonfilter -i "$signal_file" -e '@.snr' 2>/dev/null || true)"
	registration="$(jsonfilter -i "$serving_file" -e '@.registration' 2>/dev/null || true)"
	plmn_mcc="$(jsonfilter -i "$serving_file" -e '@.plmn_mcc' 2>/dev/null || true)"
	plmn_mnc="$(jsonfilter -i "$serving_file" -e '@.plmn_mnc' 2>/dev/null || true)"
	roaming="$(jsonfilter -i "$serving_file" -e '@.roaming' 2>/dev/null || true)"

	mode="$(safe_word "$mode")"
	data_status="$(safe_word "$data_status")"
	radio_type="$(safe_word "$radio_type")"
	registration="$(safe_word "$registration")"
	rssi="$(safe_number "$rssi")"
	rsrq="$(safe_number "$rsrq")"
	rsrp="$(safe_number "$rsrp")"
	snr="$(safe_number "$snr")"
	case "$plmn_mcc" in ''|*[!0-9]*) plmn_mcc=UNKNOWN ;; esac
	case "$plmn_mnc" in ''|*[!0-9]*) plmn_mnc=UNKNOWN ;; esac
	case "$roaming" in true) roaming_display=YES ;; false) roaming_display=NO ;; *) roaming_display=UNKNOWN ;; esac
	case "$radio_type" in
		lte|LTE) radio_display=LTE ;;
		gsm|GSM) radio_display=GSM ;;
		umts|UMTS) radio_display=UMTS ;;
		wcdma|WCDMA) radio_display=WCDMA ;;
		cdma|CDMA) radio_display=CDMA ;;
		*) radio_display="$radio_type" ;;
	esac

	{
		printf '%s\n' 'DIGITAL DROPKICK — CELLULAR IDENTITY & SIGNAL SNAPSHOT'
		printf '%s\n' 'Read-only fixed UQMI profile; subscriber IDs, phone number, SIM contents, APN, location, and raw commands are excluded.'
		printf 'Generated (UTC): '
		date -u
		printf '\n[MODEM]\n'
		printf '%s\n' 'Model: Quectel EC25-AF'
		printf '%s\n' 'USB identity: 2c7c:0125'
		printf '%s\n' 'Management: /dev/cdc-wdm0 via qmi_wwan'
		printf '%s\n' 'Network interface: wwan0'
		printf 'Operating mode: %s\n' "$mode"
		printf 'QMI data session: %s\n' "$data_status"
		printf '\n[REGISTRATION]\n'
		printf 'State: %s\n' "$registration"
		printf 'PLMN: %s-%s\n' "$plmn_mcc" "$plmn_mnc"
		printf 'Roaming: %s\n' "$roaming_display"
		printf '\n[RADIO SIGNAL]\n'
		printf 'Radio: %s\n' "$radio_display"
		printf 'RSSI: %s dBm\n' "$rssi"
		printf 'RSRQ: %s dB\n' "$rsrq"
		printf 'RSRP: %s dBm\n' "$rsrp"
		printf 'SNR: %s dB\n' "$snr"
		printf '\nQuery status: %s/4 succeeded\n' "$query_success"
	} > "$job_dir/stdout.next"
	head -c 32768 "$job_dir/stdout.next" > "$job_dir/stdout"
	rm -f "$job_dir/stdout.next" "$mode_file" "$data_file" "$signal_file" "$serving_file"
	if [ "$query_success" -eq 0 ]; then result=69; fi
fi

head -c 32768 "$job_dir/stderr" > "$job_dir/stderr.next" 2>/dev/null || true
mv "$job_dir/stderr.next" "$job_dir/stderr" 2>/dev/null || true

if [ "$result" -eq 0 ]; then
	status_set complete
else
	printf 'Worker exit code: %s\n' "$result" >> "$job_dir/stderr"
	status_set failed
fi

exit "$result"
