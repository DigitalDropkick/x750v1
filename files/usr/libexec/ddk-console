local function active_job_count()
	local count = 0
	local iterator = fs.dir(JOB_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) then
				if job_process_active(name) then count = count + 1 end
			end
		end
	end
	return count
end

local function has_active_action(action_id)
	local iterator = fs.dir(JOB_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) then
				local base = JOB_ROOT .. "/" .. name
				if job_process_active(name) then
					local metadata = parse_json(fs.readfile(base .. "/metadata.json"))
					if metadata and metadata.action_id == action_id then return true end
				end
			end
		end
	end
	return false
end

local function has_active_resource(resource_id)
	local iterator = fs.dir(JOB_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) then
				local base = JOB_ROOT .. "/" .. name
				if job_process_active(name) then
					local metadata = parse_json(fs.readfile(base .. "/metadata.json"))
					if metadata and metadata.resource == resource_id then return true end
				end
			end
		end
	end
	return false
end

local function lock_owner_active(job_id)
	return job_process_active(job_id)
end

acquire_lock = function(key, job_id)
	if type(key) ~= "string" or not key:match("^[a-z0-9][a-z0-9_.-]+$") then return false, "Invalid DDK lock key" end
	local path = LOCK_ROOT .. "/" .. key
	for attempt = 1, 2 do
		if fs.mkdir(path, "0700") then
			if not write_file(path .. "/owner", job_id .. "\n") then
				fs.rmdir(path)
				return false, "Unable to record DDK lock ownership"
			end
			fs.chmod(path .. "/owner", "0600")
			return true
		end
		local owner = trim(fs.readfile(path .. "/owner"))
		local stat = fs.stat(path)
		if owner == "" then
			if not stat or os.time() - (stat.mtime or os.time()) <= 5 then return false, "DDK resource is already locked" end
		elseif owner:match("^delete%-%d+%-%d+$") and stat and os.time() - (stat.mtime or os.time()) <= 30 then
			return false, "DDK resource is already locked"
		elseif owner:match("^probe%-%d+%-%d+$") and stat and os.time() - (stat.mtime or os.time()) <= 60 then
			return false, "DDK resource is already locked"
		elseif lock_owner_active(owner) then
			return false, "DDK resource is already locked"
		end
		fs.unlink(path .. "/owner")
		fs.rmdir(path)
	end
	return false, "Unable to claim DDK resource lock"
end

release_lock = function(key, job_id)
	if type(key) ~= "string" or not key:match("^[a-z0-9][a-z0-9_.-]+$") then return end
	local path = LOCK_ROOT .. "/" .. key
	if trim(fs.readfile(path .. "/owner")) == job_id then
		fs.unlink(path .. "/owner")
		fs.rmdir(path)
	end
end

delete_upload = function(upload_id)
	if not valid_upload_id(upload_id) then return nil, "Invalid DDK upload ID" end
	fs.mkdirr(LOCK_ROOT)
	fs.chmod("/tmp/ddk", "0700")
	fs.chmod(LOCK_ROOT, "0700")
	local owner = "delete-" .. tostring(os.time()) .. "-" .. tostring(nixio.getpid())
	local key = "upload-" .. upload_id
	local locked, lock_error = acquire_lock(key, owner)
	if not locked then return nil, lock_error or "DDK upload is in use by an active job" end
	local result, err = delete_upload_unlocked(upload_id)
	release_lock(key, owner)
	return result, err
end

local function acquire_job_locks(job_id, action_id, singleton, resource, extra_keys)
	local keys = {}
	local slot_key
	for slot = 1, MAX_ACTIVE_JOBS do
		local candidate = "slot-" .. tostring(slot)
		if acquire_lock(candidate, job_id) then slot_key = candidate; break end
	end
	if not slot_key then return nil, "Two DDK jobs are already active" end
	keys[#keys + 1] = slot_key
	local requested = {}
	if singleton then requested[#requested + 1] = "action-" .. action_id end
	if resource then requested[#requested + 1] = "resource-" .. resource end
	for _, key in ipairs(extra_keys or {}) do requested[#requested + 1] = key end
	for _, key in ipairs(requested) do
		local ok, err = acquire_lock(key, job_id)
		if not ok then
			for _, acquired in ipairs(keys) do release_lock(acquired, job_id) end
			return nil, err
		end
		keys[#keys + 1] = key
	end
	return keys
end

local function start_job(action_id, operator_plan)
	local spec = job_actions[action_id]
	if not spec then return nil, "Unknown or disabled job action" end
	if spec.operator_only and not operator_plan then return nil, "This action requires a validated Operator Mode request" end
	local worker = spec.worker
	local label = spec.label
	local class = spec.class
	local resource = spec.resource
	local singleton = spec.singleton
	local worker_executable = DEFAULT_JOB_WORKER
	if operator_plan then
		local backend = operator_backends[action_id]
		if not backend or operator_plan.action_id ~= action_id or operator_plan.worker ~= backend.worker or
		   type(operator_plan.argv) ~= "table" or not backend_allows_executable(backend, operator_plan.argv[1]) then
			return nil, "Prepared action does not match an exact Operator Mode backend"
		end
		worker = operator_plan.worker
		label = operator_plan.label
		class = operator_plan.class
		resource = operator_plan.resource
		singleton = operator_plan.singleton
		worker_executable = backend.worker_executable or DEFAULT_JOB_WORKER
		if worker_executable ~= DEFAULT_JOB_WORKER and worker_executable ~= APPLE_JOB_WORKER and worker_executable ~= PHASE3_JOB_WORKER and worker_executable ~= PHASE4_JOB_WORKER then return nil, "Prepared action selected an invalid DDK worker" end
	end
	if spec.required_hardware == "rtl_sdr" then
		local probe = rtl_sdr_probe()
		if not probe.ready then return nil, "Reviewed RTL-SDR hardware is not ready: " .. probe.reason end
	elseif spec.required_hardware == "camera" then
		local probe = camera_probe()
		if not probe.ready then return nil, "Reviewed UVC camera hardware is not ready: " .. probe.reason end
		if trim(capture("uci -q get mjpg-streamer.core.enabled")) ~= "0" or
		   trim(capture("uci -q get motion.general.enabled")) ~= "0" then
			return nil, "Existing camera services are not explicitly disabled"
		end
		if trim(capture("pidof fswebcam mjpg_streamer motion v4l2rtspserver")) ~= "" then
			return nil, "A camera client or service is already active"
		end
	elseif spec.required_hardware == "gps" then
		local probe = gps_probe()
		if not probe.ready then return nil, "Reviewed USB GNSS hardware is not ready: " .. probe.reason end
		if trim(capture("pidof gpsd")) ~= "" then return nil, "gpsd is active; the console will not compete for its GNSS device" end
	elseif spec.required_hardware == "can" then
		local probe = can_probe()
		if not probe.ready then return nil, "Passive CAN capture is not ready: " .. probe.reason end
	elseif spec.required_hardware == "phase4_bluetooth" then
		if #phase4_bluetooth_devices() < 1 then return nil, "No active reviewed Bluetooth HCI controller is present" end
	elseif spec.required_hardware == "phase4_relay" then
		if #phase4_relay_devices() < 1 then return nil, "No compatible relay controller with a selectable serial identity is present" end
	elseif spec.required_hardware == "phase4_smartcard" then
		if not hardware_snapshot().classes.smartcard then return nil, "No reviewed smartcard reader or YubiKey hardware is present" end
	elseif spec.required_hardware == "android" then
		local probe = identity_probe("android")
		if not probe.action_ready then return nil, "Reviewed Android USB hardware with an ADB interface is not present" end
	elseif spec.required_hardware == "apple_normal" then
		local probe = identity_probe("apple_mobile")
		if (probe.normal_count or 0) < 1 then return nil, "Reviewed normal-mode Apple USB hardware is not present" end
	elseif spec.required_hardware == "apple_recovery" then
		local probe = identity_probe("apple_mobile")
		if (probe.recovery_count or 0) + (probe.dfu_count or 0) < 1 then return nil, "Reviewed Apple recovery/DFU USB hardware with a parseable ECID is not present" end
	elseif spec.required_hardware == "apple_any" then
		local probe = identity_probe("apple_mobile")
		if not probe.action_ready then return nil, "Reviewed Apple USB hardware with a selectable UDID or ECID is not present" end
	elseif type(spec.required_hardware) == "string" and spec.required_hardware:match("^firmware_") then
		local probe = firmware_inventories()
		local ready = spec.required_hardware == "firmware_openocd" and #probe.debug_adapter_devices > 0 or
			spec.required_hardware == "firmware_avrdude" and #probe.connection_devices > 0 or
			spec.required_hardware == "firmware_dfu" and #probe.dfu_devices > 0 or
			spec.required_hardware == "firmware_serial" and #probe.serial_devices > 0
		if not ready then return nil, "No reviewed target is present for this exact firmware workflow" end
	elseif spec.required_hardware == "storage" then
		if #storage_inventory() < 1 then return nil, "No selectable non-system USB block target is present; active extroot and system media remain excluded" end
	end
	fs.mkdirr(JOB_ROOT)
	fs.mkdirr(REPORT_ROOT)
	fs.mkdirr(LOCK_ROOT)
	fs.chmod("/tmp/ddk", "0700")
	fs.chmod(JOB_ROOT, "0700")
	fs.chmod(REPORT_ROOT, "0700")
	fs.chmod(LOCK_ROOT, "0700")
	cleanup_transient()
	if active_job_count() >= MAX_ACTIVE_JOBS then return nil, "Two DDK jobs are already active" end
	if singleton and has_active_action(action_id) then
		return nil, "This bounded job is already active"
	end
	if resource and has_active_resource(resource) then
		return nil, "The required hardware resource is already in use by a DDK job"
	end
	local extroot_artifact_ceiling = 0
	for _, artifact in ipairs(operator_plan and operator_plan.artifacts or {}) do
		if type(artifact) == "table" and artifact.storage == "extroot" then
			extroot_artifact_ceiling = extroot_artifact_ceiling + (tonumber(artifact.max_size) or 0)
		end
	end
	local extroot_workspace_reserve = 0
	for _, workspace in ipairs(operator_plan and operator_plan.workspaces or {}) do
		if type(workspace) == "table" and workspace.storage == "extroot" then extroot_workspace_reserve = extroot_workspace_reserve + (tonumber(workspace.reserve_size) or 0) end
	end
	local extroot_job_ceiling = extroot_artifact_ceiling + extroot_workspace_reserve
	if extroot_job_ceiling > 0 then
		local available_kb = tonumber(trim(capture("df -Pk /overlay | awk 'NR == 2 {print $4}'", 128, 5))) or 0
		local required_kb = math.ceil((extroot_job_ceiling + MIN_OVERLAY_RESERVE) / 1024)
		if available_kb < required_kb then return nil, "Extroot does not have enough free space for the reviewed artifact/workspace ceiling and appliance reserve" end
	end

	local job_id, job_dir
	for offset = 0, 9 do
		job_id = string.format("job-%d-%d", os.time() + offset, nixio.getpid())
		job_dir = JOB_ROOT .. "/" .. job_id
		if not fs.stat(job_dir) then break end
		job_id, job_dir = nil, nil
	end
	if not job_id then return nil, "Unable to allocate a unique DDK job ID" end
	if not fs.mkdir(job_dir, "0700") then return nil, "Unable to create the DDK job directory" end
	local extroot_allocated = false
	local function cleanup_prelaunch_job()
		if extroot_allocated then remove_artifact_tree(job_id) end
		remove_owned_tree(job_dir, job_dir)
	end
	if not write_file(job_dir .. "/status", "queued\n") then
		cleanup_prelaunch_job()
		return nil, "Unable to initialize the DDK job directory"
	end
	if extroot_job_ceiling > 0 then
		fs.mkdirr(UPLOAD_PARENT)
		fs.mkdirr(ARTIFACT_ROOT)
		fs.chmod(UPLOAD_PARENT, "0700")
		fs.chmod(ARTIFACT_ROOT, "0700")
		local artifact_job_dir = ARTIFACT_ROOT .. "/" .. job_id
		if fs.lstat(artifact_job_dir) or not fs.mkdir(artifact_job_dir, "0700") then
			cleanup_prelaunch_job()
			return nil, "Unable to allocate isolated extroot artifact storage"
		end
		extroot_allocated = true
		for _, workspace in ipairs(operator_plan and operator_plan.workspaces or {}) do
			local workspace_path = artifact_job_dir .. "/workspace-" .. workspace.name
			if fs.lstat(workspace_path) or not fs.mkdir(workspace_path, "0700") then
				cleanup_prelaunch_job()
				return nil, "Unable to allocate an isolated extroot workspace"
			end
		end
	end
	local upload_lock_keys = {}
	for _, upload in ipairs(operator_plan and operator_plan.input_uploads or {}) do
		if type(upload) ~= "table" or not valid_upload_id(upload.id) then
			cleanup_prelaunch_job()
			return nil, "Prepared action contains an invalid input upload"
		end
		upload_lock_keys[#upload_lock_keys + 1] = "upload-" .. upload.id
	end
	local lock_keys, lock_error = acquire_job_locks(job_id, action_id, singleton, resource, upload_lock_keys)
	if not lock_keys then cleanup_prelaunch_job(); return nil, lock_error end
	local live_uploads, upload_map = {}, {}
	for _, expected in ipairs(operator_plan and operator_plan.input_uploads or {}) do
		local upload, upload_error = sealed_upload_record(expected.id, expected.kind)
		if not upload or upload.sha256 ~= expected.sha256 or upload.size ~= expected.size then
			for _, key in ipairs(lock_keys) do release_lock(key, job_id) end
			cleanup_prelaunch_job()
			return nil, upload_error or "Prepared input upload changed before job start"
		end
		live_uploads[#live_uploads + 1] = upload
		upload_map[upload.id] = upload
	end
	local report_id = worker == "system_report" and job_id:gsub("^job%-", "report-") or nil
	local metadata = {
		id = job_id,
		action_id = action_id,
		label = label,
		class = class,
		resource = resource,
		created_at = os.time(),
		report_id = report_id,
		operator_mode = operator_plan and true or false,
		options = operator_plan and operator_plan.options or nil,
		target_summary = operator_plan and operator_plan.target_summary or nil,
		argv_preview = operator_plan and operator_plan.argv_preview or nil,
		artifacts = operator_plan and operator_plan.artifacts or nil,
		workspaces = operator_plan and operator_plan.workspaces or nil,
		input_uploads = (function()
			local result = {}
			for _, upload in ipairs(live_uploads) do
				result[#result + 1] = { id = upload.id, kind = upload.kind, original_name = upload.original_name, size = upload.size, sha256 = upload.sha256, expires_at = upload.expires_at }
			end
			return result
		end)()
	}
	local metadata_body = json.stringify(metadata)
	local input_upload_body = #live_uploads > 0 and json.stringify(live_uploads) or nil
	if not metadata_body or not write_file(job_dir .. "/stdout", "") or not write_file(job_dir .. "/stderr", "") or
	   not write_file(job_dir .. "/metadata.json", metadata_body .. "\n") or
	   (#live_uploads > 0 and (not input_upload_body or not write_file(job_dir .. "/input-uploads.json", input_upload_body .. "\n"))) or
		   not write_file(job_dir .. "/lock-keys", table.concat(lock_keys, "\n") .. "\n") then
		for _, key in ipairs(lock_keys) do release_lock(key, job_id) end
		cleanup_prelaunch_job()
		return nil, "Unable to initialize DDK job metadata"
	end
	for _, private_input in ipairs(operator_plan and operator_plan.private_inputs or {}) do
		local private_path = job_dir .. "/private-" .. private_input.name .. ".hex"
		if not write_file(private_path, private_input.hex .. "\n") then
			for _, key in ipairs(lock_keys) do release_lock(key, job_id) end
			cleanup_prelaunch_job()
			return nil, "Unable to isolate a private Operator Mode input"
		end
		fs.chmod(private_path, "0600")
	end
	if operator_plan then
		local allowed_artifacts = {}
		for _, artifact in ipairs(operator_plan.artifacts or {}) do
			if type(artifact) == "table" and type(artifact.name) == "string" then allowed_artifacts[artifact.name] = artifact.storage or "tmp" end
		end
		local allowed_workspaces = {}
		for _, workspace in ipairs(operator_plan.workspaces or {}) do
			if type(workspace) == "table" and type(workspace.name) == "string" and workspace.storage == "extroot" then allowed_workspaces[workspace.name] = true end
		end
		local function resolve_argv(source)
			local lines = {}
			for _, original in ipairs(source or {}) do
				local argument = original
				local job_prefix, artifact_name, job_suffix
				local extroot_prefix, extroot_artifact_name, extroot_suffix
				local upload_prefix, upload_id, upload_suffix
				if type(argument) == "string" then
					job_prefix, artifact_name, job_suffix = argument:match("^([A-Za-z0-9_:,=+.-]*)@JOB@/([A-Za-z0-9][A-Za-z0-9_.-]+)([A-Za-z0-9_:,=+.-]*)$")
					extroot_prefix, extroot_artifact_name, extroot_suffix = argument:match("^([A-Za-z0-9_:,=+.-]*)@ARTIFACT@/([A-Za-z0-9][A-Za-z0-9_.-]+)([A-Za-z0-9_:,=+.-]*)$")
					upload_prefix, upload_id, upload_suffix = argument:match("^([A-Za-z0-9_:,=+.-]*)@UPLOAD@/(upload%-%d+%-%d+%-%d+)([A-Za-z0-9_:,=+.-]*)$")
				end
				local workspace_name = type(argument) == "string" and argument:match("^@WORK@/([A-Za-z0-9][A-Za-z0-9-]+)$") or nil
				if type(argument) == "string" and argument:find("@JOB@", 1, true) and not artifact_name then
					return nil, "Prepared argv contains an invalid artifact placeholder"
				end
				if type(argument) == "string" and argument:find("@ARTIFACT@", 1, true) and not extroot_artifact_name then
					return nil, "Prepared argv contains an invalid extroot artifact placeholder"
				end
				if type(argument) == "string" and argument:find("@UPLOAD@", 1, true) and not upload_id then
					return nil, "Prepared argv contains an invalid input upload placeholder"
				end
				if type(argument) == "string" and argument:find("@WORK@", 1, true) and not workspace_name then return nil, "Prepared argv contains an invalid workspace placeholder" end
				if artifact_name then
					local registered = allowed_artifacts[artifact_name]
					if artifact_name == "nmap" and allowed_artifacts["nmap.nmap"] == "tmp" and allowed_artifacts["nmap.xml"] == "tmp" and allowed_artifacts["nmap.gnmap"] == "tmp" then registered = "tmp" end
					if registered ~= "tmp" then return nil, "Prepared argv references an unregistered temporary artifact" end
					argument = job_prefix .. job_dir .. "/" .. artifact_name .. job_suffix
				end
				if extroot_artifact_name then
					if allowed_artifacts[extroot_artifact_name] ~= "extroot" then return nil, "Prepared argv references an unregistered extroot artifact" end
					argument = extroot_prefix .. ARTIFACT_ROOT .. "/" .. job_id .. "/" .. extroot_artifact_name .. extroot_suffix
				end
				if upload_id then
					if not upload_map[upload_id] then return nil, "Prepared argv references an undeclared input upload" end
					argument = upload_prefix .. upload_map[upload_id].sealed_path .. upload_suffix
				end
				if workspace_name then
					if not allowed_workspaces[workspace_name] then return nil, "Prepared argv references an undeclared isolated workspace" end
					argument = ARTIFACT_ROOT .. "/" .. job_id .. "/workspace-" .. workspace_name
				end
				if type(argument) ~= "string" or argument == "" or argument:find("[%z\r\n]") then
					return nil, "Prepared argv contains an invalid element"
				end
				lines[#lines + 1] = argument
			end
			return lines
		end
		local argv_lines, argv_error = resolve_argv(operator_plan.argv)
		local decode_lines, decode_error
		if operator_plan.decode_argv then decode_lines, decode_error = resolve_argv(operator_plan.decode_argv) end
		if not argv_lines or (operator_plan.decode_argv and not decode_lines) then
			for _, key in ipairs(lock_keys) do release_lock(key, job_id) end
			cleanup_prelaunch_job()
			return nil, argv_error or decode_error
		end
		if not write_file(job_dir .. "/argv", table.concat(argv_lines, "\n") .. "\n") or
		   not write_file(job_dir .. "/wall-timeout", tostring(operator_plan.wall_timeout) .. "\n") or
		   (decode_lines and not write_file(job_dir .. "/decode-argv", table.concat(decode_lines, "\n") .. "\n")) or
		   (operator_plan.private_input_hex and not write_file(job_dir .. "/stdin-hex", operator_plan.private_input_hex .. "\n")) then
			for _, key in ipairs(lock_keys) do release_lock(key, job_id) end
			cleanup_prelaunch_job()
			return nil, "Unable to persist the prepared native execution plan"
		end
	end
	fs.chmod(job_dir, "0700")
	for _, name in ipairs({ "metadata.json", "input-uploads.json", "lock-keys", "argv", "decode-argv", "wall-timeout", "stdin-hex" }) do
		if fs.stat(job_dir .. "/" .. name) then fs.chmod(job_dir .. "/" .. name, "0600") end
	end

	-- Both interpolated values are generated or exact server-side allowlist literals.
	local command = string.format("%s %s %s </dev/null >/dev/null 2>&1 &", worker_executable, job_id, worker)
	local result = os.execute(command)
	if result ~= 0 and result ~= true then
		write_file(job_dir .. "/status", "failed\n")
		write_file(job_dir .. "/stderr", "Worker launch failed\n")
		for _, key in ipairs(lock_keys) do release_lock(key, job_id) end
		remove_artifact_tree(job_id)
		return nil, "Worker launch failed"
	end
	return job_state(job_id)
end

local function list_jobs()
	cleanup_transient()
	local jobs = {}
	local iterator = fs.dir(JOB_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) then
				local state = job_state(name)
				if state then jobs[#jobs + 1] = state end
			end
		end
	end
	table.sort(jobs, function(a, b)
		return (a.metadata.created_at or 0) > (b.metadata.created_at or 0)
	end)
	return jobs
end

local function stop_job(job_id)
	if not valid_job_id(job_id) then return nil, "Invalid DDK job ID" end
	local state = job_state(job_id)
	if not state then return nil, "Job not found" end
	if state.status ~= "queued" and state.status ~= "running" then return nil, "Job is not active" end
	local pid = tonumber(state.pid)
	if not pid or pid < 2 then return nil, "Worker PID is unavailable" end
	local cmdline = fs.readfile("/proc/" .. pid .. "/cmdline") or ""
	cmdline = cmdline:gsub("%z", " ")
	if (not cmdline:find(DEFAULT_JOB_WORKER, 1, true) and not cmdline:find(APPLE_JOB_WORKER, 1, true) and not cmdline:find(PHASE3_JOB_WORKER, 1, true) and not cmdline:find(PHASE4_JOB_WORKER, 1, true)) or not cmdline:find(job_id, 1, true) then
		return nil, "PID does not belong to this DDK job"
	end
	write_file(JOB_ROOT .. "/" .. job_id .. "/status", "stopping\n")
	local killed = nixio.kill(pid, 15)
	if not killed then
		write_file(JOB_ROOT .. "/" .. job_id .. "/status", state.status .. "\n")
		return nil, "Unable to signal DDK worker"
	end
	return job_state(job_id)
end

local function list_reports()
	cleanup_transient()
	local reports = {}
	local iterator = fs.dir(REPORT_ROOT)
	if iterator then
		for name in iterator do
			local report_id = name:match("^(report%-%d+%-%d+)%.txt$")
			if report_id then
				local stat = fs.stat(REPORT_ROOT .. "/" .. name)
				reports[#reports + 1] = {
					id = report_id,
					size = stat and stat.size or 0,
					created_at = stat and stat.mtime or 0
				}
			end
		end
	end
	table.sort(reports, function(a, b) return a.created_at > b.created_at end)
	return reports
end

local verb = arg[1]

if verb == "status" and #arg == 1 then
	respond(true, system_status())
elseif verb == "capabilities" and #arg == 1 then
	respond(true, load_capabilities())
elseif verb == "packages" and #arg == 1 then
	local packages = package_inventory()
	respond(true, packages)
elseif verb == "info" and #arg == 2 then
	local action_id = arg[2]
	local spec = info_actions[action_id]
	if not spec then respond(false, nil, "Unknown or disabled INFO action", "ACTION_NOT_ALLOWED") end
	local output, truncated
	if spec.render then
		output = spec.render()
		truncated = #output > MAX_CAPTURE
		if truncated then output = output:sub(1, MAX_CAPTURE) end
	else
		output, truncated = capture(spec.command, MAX_CAPTURE)
	end
	respond(true, { action_id = action_id, class = "INFO", label = spec.label, output = output, truncated = truncated })
elseif verb == "action" and arg[2] == "describe" and #arg == 3 then
	local schema, err = describe_operator_action(arg[3])
	if not schema then respond(false, nil, err, "ACTION_SCHEMA_REJECTED") end
	respond(true, schema)
elseif verb == "action" and arg[2] == "prepare" and #arg == 4 then
	local prepared, err = prepare_operator_action(arg[3], arg[4])
	if not prepared then respond(false, nil, err, "ACTION_PREPARE_REJECTED") end
	respond(true, prepared)
elseif verb == "upload" and arg[2] == "list" and #arg == 2 then
	respond(true, list_uploads())
elseif verb == "upload" and arg[2] == "reserve" and #arg == 4 then
	local reserved, err = reserve_upload(arg[3], arg[4])
	if not reserved then respond(false, nil, err, "UPLOAD_RESERVE_REJECTED") end
	respond(true, reserved)
elseif verb == "upload" and arg[2] == "finalize" and #arg == 3 then
	local uploaded, err = finalize_upload(arg[3])
	if not uploaded then respond(false, nil, err, "UPLOAD_FINALIZE_REJECTED") end
	respond(true, uploaded)
elseif verb == "upload" and arg[2] == "delete" and #arg == 3 then
	local deleted, err = delete_upload(arg[3])
	if not deleted then respond(false, nil, err, "UPLOAD_DELETE_REJECTED") end
	respond(true, deleted)
elseif verb == "job" and arg[2] == "list" and #arg == 2 then
	respond(true, list_jobs())
elseif verb == "job" and arg[2] == "start" and (#arg == 3 or #arg == 4) then
	local state, err
	if valid_prepared_id(arg[3]) then
		local plan, claim_path
		plan, claim_path, err = claim_prepared_action(arg[3], arg[4])
		if plan then
			state, err = start_job(plan.action_id, plan)
			remove_prepared_tree(claim_path)
		end
	elseif #arg == 3 then
		state, err = start_job(arg[3])
	else
		err = "Legacy action IDs do not accept browser parameters"
	end
	if not state then respond(false, nil, err, "JOB_START_REJECTED") end
	respond(true, state)
elseif verb == "job" and arg[2] == "status" and #arg == 3 then
	if not valid_job_id(arg[3]) then respond(false, nil, "Invalid DDK job ID", "INVALID_JOB_ID") end
	local state = job_state(arg[3])
	if not state then respond(false, nil, "Job not found", "JOB_NOT_FOUND") end
	respond(true, state)
elseif verb == "job" and arg[2] == "stop" and #arg == 3 then
	local state, err = stop_job(arg[3])
	if not state then respond(false, nil, err, "JOB_STOP_REJECTED") end
	respond(true, state)
elseif verb == "report" and arg[2] == "list" and #arg == 2 then
	respond(true, list_reports())
elseif verb == "report" and arg[2] == "view" and #arg == 3 then
	if not valid_report_id(arg[3]) then respond(false, nil, "Invalid report ID", "INVALID_REPORT_ID") end
	local content, truncated = read_limited(REPORT_ROOT .. "/" .. arg[3] .. ".txt", MAX_CAPTURE)
	if not content then respond(false, nil, "Report not found", "REPORT_NOT_FOUND") end
	respond(true, { id = arg[3], content = content, truncated = truncated })
else
	respond(false, nil, "Invalid command or argument count", "INVALID_REQUEST")
end
