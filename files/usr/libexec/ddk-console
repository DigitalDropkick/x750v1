		singleton = true
	},
	["network.nmap_lan_discovery"] = {
		worker = "nmap_lan_discovery",
		label = "Nmap LAN Host Discovery",
		class = "SECURITY",
		singleton = true
	},
	["capture.lan_metadata_snapshot"] = {
		worker = "tcpdump_lan_metadata",
		label = "LAN Metadata Snapshot",
		class = "SECURITY",
		singleton = true
	},
	["radio.rtl433_snapshot"] = {
