#!/usr/bin/lua

-- Digital Dropkick Field Console backend.
-- Browser input selects exact allowlist entries; it never becomes shell syntax.

local fs = require "nixio.fs"
local json = require "luci.jsonc"
local nixio = require "nixio"

local TOOL_ROOT = "/usr/share/ddk-field-console/tools"
local JOB_ROOT = "/tmp/ddk/jobs"
local REPORT_ROOT = "/tmp/ddk/reports"
local MAX_CAPTURE = 131072
local MAX_STDERR = 32768
local MAX_CAMERA_ARTIFACT = 262144
local MAX_ACTIVE_JOBS = 2
local MAX_RETAINED_JOBS = 20
local JOB_MAX_AGE = 4 * 60 * 60
local REPORT_MAX_AGE = 24 * 60 * 60

local function trim(value)
	return (tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function respond(ok, data, message, code)
	io.write(json.stringify({
		ok = ok and true or false,
		data = data,
		message = message,
		code = code
	}) or '{"ok":false,"message":"JSON encoding failed"}')
	io.write("\n")
	os.exit(ok and 0 or 1)
end

local function read_limited(path, limit)
	local handle = io.open(path, "rb")
	if not handle then
		return nil, false
	end
	local value = handle:read(limit or MAX_CAPTURE) or ""
	local extra = handle:read(1)
	handle:close()
	return value, extra ~= nil
end

local function write_file(path, value)
	local handle = io.open(path, "wb")
	if not handle then
		return false
	end
	handle:write(value or "")
	handle:close()
	return true
end

local function shell_quote(value)
	return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function capture(command, limit)
	-- All callers pass source-code constants. No request value reaches this string.
	local handle = io.popen("LC_ALL=C timeout 12 sh -c " .. shell_quote(command) .. " 2>&1")
	if not handle then
		return "", false
	end
	local chunks = {}
	local total = 0
	local cap = limit or MAX_CAPTURE
	local truncated = false
	while total < cap do
		local chunk = handle:read(math.min(4096, cap - total))
		if not chunk then
			break
		end
		chunks[#chunks + 1] = chunk
		total = total + #chunk
	end
	if total >= cap then
		-- Drain without retaining so a verbose child cannot block in pclose().
		while true do
			local discarded = handle:read(4096)
			if not discarded then break end
			truncated = true
		end
	end
	handle:close()
	return table.concat(chunks), truncated
end

local function parse_json(value)
	if not value or value == "" then
		return nil
	end
	local ok, parsed = pcall(json.parse, value)
	return ok and parsed or nil
end

local function release_value(name)
	local body = fs.readfile("/etc/openwrt_release") or ""
	return body:match(name .. "='([^']*)'") or ""
end

local function meminfo()
	local values = {}
	for line in (fs.readfile("/proc/meminfo") or ""):gmatch("[^\n]+") do
		local key, number = line:match("^([^:]+):%s*(%d+)")
		if key and number then
			values[key] = tonumber(number) * 1024
		end
	end
	return values
end

local package_cache
local package_map_cache

local function package_inventory()
	if package_cache then
		return package_cache, package_map_cache
	end

	local packages = {}
	local package_map = {}
	local body = (fs.readfile("/usr/lib/opkg/status") or "") .. "\n\n"
	for paragraph in body:gmatch("(.-)\n\n") do
		local name = paragraph:match("\n?Package:%s*([^\n]+)")
		local version = paragraph:match("\nVersion:%s*([^\n]+)")
		local status = paragraph:match("\nStatus:%s*([^\n]+)")
		status = trim(status)
		if name and status:match("^%S+%s+%S+%s+installed$") then
			name = trim(name)
			if not package_map[name] then
				package_map[name] = true
				packages[#packages + 1] = {
					name = name,
					version = trim(version),
					category = false
				}
			end
		end
	end

	local function classify(name)
		local lower = name:lower()
		if lower:match("^luci%-") then
			return "LuCI"
		elseif lower:match("^kmod%-") or lower:match("^kernel") then
			return "Kernel"
		elseif lower:match("^python") or lower:match("^python3%-") then
			return "Python"
		elseif lower:match("^lib") or lower:match("%-libs?$") then
			return "Libraries"
		elseif lower:match("collectd") or lower:match("prometheus") or lower:match("vnstat") or
		       lower:match("nlbw") or lower:match("rrd") or lower == "bmon" or
		       lower == "iftop" or lower == "htop" then
			return "Monitoring"
		elseif lower:match("usb") or lower:match("serial") or lower:match("bluetooth") or
		       lower:match("gps") or lower:match("rtl") or lower:match("sdr") or
		       lower:match("modbus") or lower:match("pcsc") or lower:match("fido") or
		       lower:match("yubi") or lower:match("camera") or lower:match("mjpg") or
		       lower:match("v4l") or lower:match("adb") or lower:match("imobile") or
		       lower:match("flashrom") or lower:match("openocd") or lower:match("avrdude") or
		       lower:match("dfu") or lower:match("canutils") then
			return "Hardware"
		elseif lower:match("nmap") or lower:match("network") or lower:match("netif") or
		       lower:match("tcp") or lower:match("wifi") or lower:match("wireless") or
		       lower:match("dns") or lower:match("dhcp") or lower:match("snmp") or
		       lower:match("tailscale") or lower:match("vpn") or lower:match("firewall") or
		       lower:match("iproute") or lower:match("arp%-") then
			return "Networking"
		end
		return "Applications"
	end

	for _, item in ipairs(packages) do
		item.category = classify(item.name)
	end
	table.sort(packages, function(a, b) return a.name < b.name end)
	package_cache = packages
	package_map_cache = package_map
	return packages, package_map
end

local function binary_exists(name)
	if type(name) ~= "string" or not name:match("^[A-Za-z0-9_+%.%-/]+$") then
		return false
	end
	if name:sub(1, 1) == "/" then
		return fs.access(name, "x") and true or false
	end
	for _, prefix in ipairs({ "/usr/bin/", "/usr/sbin/", "/bin/", "/sbin/" }) do
		if fs.access(prefix .. name, "x") then
			return true
		end
	end
	return false
end

local function list_device_nodes(pattern)
	local result = {}
	local iterator = fs.dir("/dev")
	if iterator then
		for name in iterator do
			if name:match(pattern) then
				result[#result + 1] = "/dev/" .. name
			end
		end
	end
	table.sort(result)
	return result
end

local function interface_list()
	local output = capture("ip -o link show")
	local result = {}
	for line in output:gmatch("[^\n]+") do
		local name = line:match("^%d+:%s+([^:]+):")
		if name then
			result[#result + 1] = {
				name = name:gsub("@.*$", ""),
				state = line:match("%sstate%s+(%S+)") or "UNKNOWN"
			}
		end
	end
	return result
end

local function usb_lines()
	local output = binary_exists("lsusb") and capture("lsusb") or ""
	local lines = {}
	for line in output:gmatch("[^\n]+") do
		if trim(line) ~= "" then
			lines[#lines + 1] = trim(line)
		end
	end
	return lines, output:lower()
end

local function has_dir_entry(path, pattern)
	local iterator = fs.dir(path)
	if not iterator then
		return false
	end
	for name in iterator do
		if name:match(pattern) then
			return true
		end
	end
	return false
end

local function rtl_sdr_probe()
	local probe = {
		accepted_usb_ids = { "0bda:2832", "0bda:2838" },
		reviewed_count = 0,
		ready = false,
		reason = "REVIEWED HARDWARE NOT DETECTED"
	}
	local candidate
	local iterator = fs.dir("/sys/bus/usb/devices")
	if iterator then
		for name in iterator do
			local base = "/sys/bus/usb/devices/" .. name
			local vendor_id = trim(fs.readfile(base .. "/idVendor")):lower()
			local product_id = trim(fs.readfile(base .. "/idProduct")):lower()
			if vendor_id == "0bda" and (product_id == "2832" or product_id == "2838") then
				probe.reviewed_count = probe.reviewed_count + 1
				local serial = trim(fs.readfile(base .. "/serial"))
				local serial_valid = #serial > 0 and #serial <= 64 and serial:match("^[A-Za-z0-9_.%-]+$") ~= nil
				local claimed_driver = ""
				local interface_iterator = fs.dir("/sys/bus/usb/devices")
				if interface_iterator then
					for interface_name in interface_iterator do
						if interface_name:sub(1, #name + 1) == name .. ":" then
							local driver_link = fs.readlink("/sys/bus/usb/devices/" .. interface_name .. "/driver") or ""
							if driver_link ~= "" then claimed_driver = driver_link:match("([^/]+)$") or "claimed" end
						end
					end
				end
				candidate = {
					usb_id = vendor_id .. ":" .. product_id,
					serial_valid = serial_valid,
					claimed_driver = claimed_driver
				}
			end
		end
	end

	if probe.reviewed_count > 1 then
		probe.reason = "MULTIPLE REVIEWED DONGLES DETECTED"
	elseif probe.reviewed_count == 1 and candidate then
		probe.usb_id = candidate.usb_id
		probe.serial_valid = candidate.serial_valid
		probe.claimed_driver = candidate.claimed_driver
		if not candidate.serial_valid then
			probe.reason = "USB SERIAL UNAVAILABLE OR UNSAFE"
		elseif candidate.claimed_driver ~= "" then
			probe.reason = "KERNEL DRIVER CLAIMS THE TUNER"
		else
			probe.ready = true
			probe.reason = "READY - EXACTLY ONE REVIEWED DONGLE"
		end
	end
	return probe
end

local function camera_probe()
	local probe = {
		ready = false,
		reason = "REVIEWED UVC CAMERA NOT DETECTED",
		reviewed_device_count = 0,
		reviewed_node_count = 0,
		primary_node_count = 0,
		nodes = {}
	}
	local usb_devices = {}
	local primary_nodes = {}
	local iterator = fs.dir("/sys/class/video4linux")
	if iterator then
		for name in iterator do
			if name:match("^video%d+$") then
				local node = "/dev/" .. name
				local node_stat = fs.stat(node)
				local class_base = "/sys/class/video4linux/" .. name
				local device_path = fs.realpath(class_base .. "/device") or ""
				local usb_parent = device_path ~= "" and (fs.realpath(device_path .. "/..") or "") or ""
				local driver_link = device_path ~= "" and (fs.readlink(device_path .. "/driver") or "") or ""
				local driver = driver_link:match("([^/]+)$") or ""
				local interface_class = trim(fs.readfile(device_path .. "/bInterfaceClass")):lower()
				local vendor_id = trim(fs.readfile(usb_parent .. "/idVendor")):lower()
				local product_id = trim(fs.readfile(usb_parent .. "/idProduct")):lower()
				local index = trim(fs.readfile(class_base .. "/index"))
				local reviewed = node_stat and node_stat.type == "chr" and
					device_path:match("^/sys/devices/") ~= nil and usb_parent:match("^/sys/devices/") ~= nil and
					driver == "uvcvideo" and interface_class == "0e" and
					vendor_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
					product_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil

				if reviewed then
					probe.reviewed_node_count = probe.reviewed_node_count + 1
					usb_devices[usb_parent] = true
					local candidate = {
						node = node,
						name = trim(fs.readfile(class_base .. "/name")),
						index = index,
						usb_id = vendor_id .. ":" .. product_id,
						interface_number = trim(fs.readfile(device_path .. "/bInterfaceNumber")),
						driver = driver
					}
					probe.nodes[#probe.nodes + 1] = candidate
					if index == "0" then primary_nodes[#primary_nodes + 1] = candidate end
				end
			end
		end
	end

	for _ in pairs(usb_devices) do probe.reviewed_device_count = probe.reviewed_device_count + 1 end
	probe.primary_node_count = #primary_nodes
	table.sort(probe.nodes, function(a, b) return a.node < b.node end)
	table.sort(primary_nodes, function(a, b) return a.node < b.node end)

	if probe.reviewed_device_count > 1 then
		probe.reason = "MULTIPLE REVIEWED UVC CAMERAS DETECTED"
	elseif probe.reviewed_device_count == 1 and probe.reviewed_node_count > 0 then
		if #primary_nodes == 0 then
			probe.reason = "UVC PRIMARY CAPTURE NODE NOT DETECTED"
		elseif #primary_nodes > 1 then
			probe.reason = "MULTIPLE UVC PRIMARY NODES DETECTED"
		else
			probe.ready = true
			probe.reason = "READY - ONE REVIEWED UVC CAMERA"
			probe.device = primary_nodes[1].node
			probe.usb_id = primary_nodes[1].usb_id
			probe.name = primary_nodes[1].name
		end
	end
	return probe
end

local function device_open_by_process(device)
	if type(device) ~= "string" or
	   (not device:match("^/dev/ttyUSB%d+$") and not device:match("^/dev/ttyACM%d+$")) then
		return false
	end
	local process_iterator = fs.dir("/proc")
	if not process_iterator then return false end
	for pid in process_iterator do
		if pid:match("^%d+$") then
			local fd_iterator = fs.dir("/proc/" .. pid .. "/fd")
			if fd_iterator then
				for fd in fd_iterator do
					if fs.readlink("/proc/" .. pid .. "/fd/" .. fd) == device then
						return true
					end
				end
			end
		end
	end
	return false
end

local function gps_probe()
	local probe = {
		ready = false,
		hardware_present = false,
		reason = "REVIEWED USB GNSS RECEIVER NOT DETECTED",
		reviewed_device_count = 0,
		reviewed_node_count = 0,
		nodes = {}
	}
	local usb_devices = {}
	local candidate
	local serial_nodes = list_device_nodes("^ttyUSB%d+$")
	for _, node in ipairs(list_device_nodes("^ttyACM%d+$")) do serial_nodes[#serial_nodes + 1] = node end
	table.sort(serial_nodes)

	for _, node in ipairs(serial_nodes) do
		local name = node:match("^/dev/(.+)$") or ""
		local base = "/sys/class/tty/" .. name
		local node_stat = fs.stat(node)
		local interface_path = fs.realpath(base .. "/device/..") or ""
		local parent_path = fs.realpath(base .. "/device/../..") or ""
		local vendor_id = trim(fs.readfile(parent_path .. "/idVendor")):lower()
		local product_id = trim(fs.readfile(parent_path .. "/idProduct")):lower()
		local manufacturer = trim(fs.readfile(parent_path .. "/manufacturer"))
		local product = trim(fs.readfile(parent_path .. "/product"))
		local descriptor = (manufacturer .. " " .. product):lower()
		local driver_link = fs.readlink(interface_path .. "/driver") or ""
		local driver = driver_link:match("([^/]+)$") or ""
		local reviewed_driver = driver == "cdc_acm" or driver == "ftdi_sio" or
			driver == "cp210x" or driver == "pl2303" or driver == "ch341" or driver == "usbserial"
		local reviewed_identity = vendor_id == "1546" or descriptor:match("u%-blox") ~= nil or
			descriptor:match("ublox") ~= nil or descriptor:match("gnss") ~= nil or descriptor:match("gps") ~= nil
		local exact_ec25 = vendor_id == "2c7c" and product_id == "0125"
		local reviewed = node_stat and node_stat.type == "chr" and
			interface_path:match("^/sys/devices/") ~= nil and parent_path:match("^/sys/devices/") ~= nil and
			vendor_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
			product_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
			reviewed_driver and reviewed_identity and not exact_ec25

		if reviewed then
			usb_devices[parent_path] = true
			candidate = {
				node = node,
				usb_id = vendor_id .. ":" .. product_id,
				manufacturer = manufacturer,
				product = product,
				driver = driver,
				interface_number = trim(fs.readfile(interface_path .. "/bInterfaceNumber")),
				busy = device_open_by_process(node)
			}
			probe.nodes[#probe.nodes + 1] = candidate
		end
	end

	for _ in pairs(usb_devices) do probe.reviewed_device_count = probe.reviewed_device_count + 1 end
	probe.reviewed_node_count = #probe.nodes
	probe.hardware_present = probe.reviewed_device_count > 0
	if probe.reviewed_device_count > 1 then
		probe.reason = "MULTIPLE REVIEWED USB GNSS RECEIVERS DETECTED"
	elseif probe.reviewed_device_count == 1 then
		if probe.reviewed_node_count == 0 then
			probe.reason = "REVIEWED GNSS SERIAL NODE NOT DETECTED"
		elseif probe.reviewed_node_count > 1 then
			probe.reason = "MULTIPLE GNSS SERIAL NODES ARE AMBIGUOUS"
		elseif candidate and candidate.busy then
			probe.reason = "GNSS SERIAL NODE IS ALREADY IN USE"
		elseif not binary_exists("gpsdecode") then
			probe.reason = "GPSDECODE EXECUTABLE IS UNAVAILABLE"
		elseif candidate then
			probe.ready = true
			probe.reason = "READY - ONE REVIEWED USB GNSS RECEIVER"
			probe.device = candidate.node
			probe.usb_id = candidate.usb_id
			probe.driver = candidate.driver
			probe.name = trim(candidate.manufacturer .. " " .. candidate.product)
		end
	end
	return probe
end

local function serial_attribution()
	local nodes = list_device_nodes("^ttyUSB%d+$")
	for _, node in ipairs(list_device_nodes("^ttyACM%d+$")) do
		nodes[#nodes + 1] = node
	end
	table.sort(nodes)

	local devices = {}
	local summary = {
		total = 0,
		modem_reserved = 0,
		reviewed_general_purpose = 0,
		unreviewed = 0,
		unattributed = 0
	}

	for _, node in ipairs(nodes) do
		local name = node:match("^/dev/(.+)$") or ""
		local base = "/sys/class/tty/" .. name
		local interface_path = fs.realpath(base .. "/device/..") or ""
		local parent_path = fs.realpath(base .. "/device/../..") or ""
		local interface_number = trim(fs.readfile(base .. "/device/../bInterfaceNumber"))
		local vendor_id = trim(fs.readfile(base .. "/device/../../idVendor")):lower()
		local product_id = trim(fs.readfile(base .. "/device/../../idProduct")):lower()
		local manufacturer = trim(fs.readfile(base .. "/device/../../manufacturer"))
		local product = trim(fs.readfile(base .. "/device/../../product"))
		local driver_link = fs.readlink(base .. "/device/../driver") or ""
		local driver = driver_link:match("([^/]+)$") or ""
		local parent = parent_path:match("([^/]+)$") or ""
		local exact_ec25 = vendor_id == "2c7c" and product_id == "0125" and
			manufacturer:lower() == "quectel" and product:lower():match("^ec25") ~= nil and driver == "option"
		local classification
		local owner

		if exact_ec25 then
			classification = "MODEM RESERVED"
			owner = "Quectel EC25-AF cellular modem"
			summary.modem_reserved = summary.modem_reserved + 1
		elseif vendor_id ~= "" and product_id ~= "" then
			classification = "UNREVIEWED SERIAL"
			owner = trim(manufacturer .. " " .. product)
			if owner == "" then owner = "Unknown USB serial device" end
			summary.unreviewed = summary.unreviewed + 1
		else
			classification = "UNATTRIBUTED"
			owner = "Sysfs USB parent unavailable"
			summary.unattributed = summary.unattributed + 1
		end

		devices[#devices + 1] = {
			node = node,
			classification = classification,
			owner = owner,
			generic_use_allowed = false,
			usb = {
				vendor_id = vendor_id,
				product_id = product_id,
				manufacturer = manufacturer,
				product = product,
				parent = parent,
				interface_number = interface_number,
				driver = driver,
				interface_path = interface_path
			}
		}
	end

	summary.total = #devices
	return devices, summary
end

local function serial_attribution_text()
	local devices, summary = serial_attribution()
	local lines = {
		"SERIAL DEVICE ATTRIBUTION (SYSFS ONLY)",
		"Policy: read metadata only; no serial port was opened.",
		""
	}

	if #devices == 0 then
		lines[#lines + 1] = "No /dev/ttyUSB* or /dev/ttyACM* nodes detected."
	else
		for _, device in ipairs(devices) do
			local usb_id = device.usb.vendor_id ~= "" and device.usb.product_id ~= "" and
				(device.usb.vendor_id .. ":" .. device.usb.product_id) or "unavailable"
			lines[#lines + 1] = device.node
			lines[#lines + 1] = "  Classification: " .. device.classification
			lines[#lines + 1] = "  Owner: " .. device.owner
			lines[#lines + 1] = "  USB: " .. usb_id
			lines[#lines + 1] = "  Parent: " .. (device.usb.parent ~= "" and device.usb.parent or "unavailable")
			lines[#lines + 1] = "  Interface: " .. (device.usb.interface_number ~= "" and device.usb.interface_number or "unavailable")
			lines[#lines + 1] = "  Driver: " .. (device.usb.driver ~= "" and device.usb.driver or "unavailable")
			lines[#lines + 1] = "  Generic use allowed: NO"
			lines[#lines + 1] = ""
		end
	end

	lines[#lines + 1] = string.format(
		"Summary: %d total; %d modem-reserved; %d reviewed general-purpose; %d unreviewed; %d unattributed.",
		summary.total,
		summary.modem_reserved,
		summary.reviewed_general_purpose,
		summary.unreviewed,
		summary.unattributed
	)
	return table.concat(lines, "\n") .. "\n"
end

local function hardware_snapshot()
	local usb, usb_text = usb_lines()
	local rtl_sdr = rtl_sdr_probe()
	local camera = camera_probe()
	local gps = gps_probe()
	local serial, serial_summary = serial_attribution()
	local serial_nodes = {}
	for _, device in ipairs(serial) do serial_nodes[#serial_nodes + 1] = device.node end
	local video = list_device_nodes("^video%d+$")
	local i2c = list_device_nodes("^i2c%-%d+$")
	local spi = list_device_nodes("^spidev")
	local can_output = capture("ip -o link show type can")
	local can = {}
	for line in can_output:gmatch("[^\n]+") do
		local name = line:match("^%d+:%s+([^:]+):")
		if name then can[#can + 1] = name:gsub("@.*$", "") end
	end

	local classes = {
		usb = #usb > 0,
		serial = serial_summary.reviewed_general_purpose > 0,
		serial_detected = serial_summary.total > 0,
		cellular_modem = usb_text:match("quectel") ~= nil or usb_text:match("2c7c:") ~= nil,
		video = camera.ready,
		rtl_sdr = rtl_sdr.ready,
		can = #can > 0,
		bluetooth = has_dir_entry("/sys/class/bluetooth", "^hci%d+$"),
		i2c = #i2c > 0,
		spi = #spi > 0,
		gps = gps.hardware_present,
		android = usb_text:match("android") ~= nil or usb_text:match("google") ~= nil or usb_text:match("samsung") ~= nil,
		apple_mobile = usb_text:match("05ac:") ~= nil or usb_text:match("apple") ~= nil,
		smartcard = usb_text:match("smart card") ~= nil or usb_text:match("yubico") ~= nil or usb_text:match("yubikey") ~= nil or usb_text:match("ccid") ~= nil,
		programmer = usb_text:match("j%-link") ~= nil or usb_text:match("cmsis") ~= nil or usb_text:match("ftdi") ~= nil or usb_text:match("stmicro") ~= nil or usb_text:match("atmel") ~= nil,
		usb_storage = fs.stat("/sys/block/sda") ~= nil
	}

	return {
		usb_devices = usb,
		serial_devices = serial_nodes,
		serial_attribution = serial,
		serial_summary = serial_summary,
		video_devices = video,
		camera = camera,
		gps = gps,
		can_interfaces = can,
		i2c_devices = i2c,
		spi_devices = spi,
		rtl_sdr = rtl_sdr,
		classes = classes
	}
end

local function ubus_object(command)
	local output = capture(command)
	return parse_json(output) or {}
end

local function first_ipv4(status)
	local addresses = status["ipv4-address"]
	if type(addresses) == "table" and type(addresses[1]) == "table" then
		return addresses[1].address or ""
	end
	return ""
end

local function system_status()
	local board = ubus_object("ubus call system board")
	local memory = meminfo()
	local uptime_body = fs.readfile("/proc/uptime") or "0"
	local uptime = tonumber(uptime_body:match("^(%S+)")) or 0
	local load_body = fs.readfile("/proc/loadavg") or "0 0 0"
	local l1, l5, l15 = load_body:match("^(%S+)%s+(%S+)%s+(%S+)")
	local storage_line = ""
	local storage_output = capture("df -kP /")
	for line in storage_output:gmatch("[^\n]+") do
		if not line:match("^Filesystem") then storage_line = line end
	end
	local _, total_k, used_k, available_k, percent, mountpoint = storage_line:match("^(%S+)%s+(%d+)%s+(%d+)%s+(%d+)%s+(%d+)%%%s+(%S+)")
	local packages = package_inventory()
	local lan = ubus_object("ubus call network.interface.lan status")
	local wan = ubus_object("ubus call network.interface.wan status")
	local dns = {}
	for line in (fs.readfile("/tmp/resolv.conf.d/resolv.conf.auto") or ""):gmatch("[^\n]+") do
		local server = line:match("^nameserver%s+(%S+)")
		if server then dns[#dns + 1] = server end
	end
	local tailscale_installed = binary_exists("tailscale")
	local tailscale_pids = trim(capture("pidof tailscaled"))
	local tailscale_ip = tailscale_installed and trim(capture("tailscale ip -4")) or ""
	local tailscale_version = tailscale_installed and trim((capture("tailscale version")):match("[^\n]+")) or ""
	local swap_total = memory.SwapTotal or 0
	local hardware = hardware_snapshot()

	return {
		generated_at = os.time(),
		system = {
			hostname = trim(fs.readfile("/proc/sys/kernel/hostname")),
			model = board.model or "GL.iNet GL-X750",
			openwrt = release_value("DISTRIB_DESCRIPTION"),
			kernel = trim(capture("uname -r")),
			uptime_seconds = math.floor(uptime),
			load = { tonumber(l1) or 0, tonumber(l5) or 0, tonumber(l15) or 0 },
			memory = {
				total = memory.MemTotal or 0,
				available = memory.MemAvailable or 0,
				free = memory.MemFree or 0
			},
			swap = {
				total = swap_total,
				used = math.max(0, swap_total - (memory.SwapFree or 0)),
				active = swap_total > 0
			},
			storage = {
				total = (tonumber(total_k) or 0) * 1024,
				used = (tonumber(used_k) or 0) * 1024,
				available = (tonumber(available_k) or 0) * 1024,
				percent = tonumber(percent) or 0,
				mountpoint = mountpoint or "/"
			},
			package_count = #packages
		},
		network = {
			lan_ip = first_ipv4(lan),
			wan_interface = wan.l3_device or wan.device or "",
			wan_up = wan.up and true or false,
			wan_ip = first_ipv4(wan),
			default_route = trim((capture("ip route show default")):match("[^\n]+")),
			dns = dns,
			interfaces = interface_list()
		},
		remote_access = {
			tailscale_installed = tailscale_installed,
			tailscale_running = tailscale_pids ~= "",
			tailscale_ip = tailscale_ip,
			tailscale_version = tailscale_version
		},
		hardware = hardware
	}
end

local valid_probe_ids = {
	software = true, usb = true, serial = true, serial_detected = true, cellular_modem = true,
	video = true, rtl_sdr = true, can = true, bluetooth = true,
	i2c = true, spi = true, gps = true, android = true,
	apple_mobile = true, smartcard = true, programmer = true,
	usb_storage = true
}

local function string_array(value)
	if type(value) ~= "table" then return {} end
	local result = {}
	for _, item in ipairs(value) do
		if type(item) == "string" then result[#result + 1] = item end
	end
	return result
end

local function load_capabilities()
	local _, package_map = package_inventory()
	local hardware = hardware_snapshot()
	local names = {}
	local iterator = fs.dir(TOOL_ROOT)
	if iterator then
		for name in iterator do
			if name:match("^[a-z0-9][a-z0-9_.%-]+%.json$") then names[#names + 1] = name end
		end
	end
	table.sort(names)

	local modules = {}
	for _, name in ipairs(names) do
		local manifest = parse_json(fs.readfile(TOOL_ROOT .. "/" .. name))
		if type(manifest) == "table" and type(manifest.id) == "string" and
		   manifest.id:match("^[a-z0-9][a-z0-9_.%-]+$") and type(manifest.name) == "string" and
		   type(manifest.category) == "string" then
			local package_names = string_array(manifest.package_names)
			local binaries = string_array(manifest.expected_binaries)
			local required = string_array(manifest.required_hardware)
			local matched_packages = {}
			local matched_binaries = {}
			for _, package_name in ipairs(package_names) do
				if package_map[package_name] then matched_packages[#matched_packages + 1] = package_name end
			end
			for _, binary in ipairs(binaries) do
				if binary_exists(binary) then matched_binaries[#matched_binaries + 1] = binary end
			end
			local software_installed = #matched_packages > 0 or #matched_binaries > 0
			local missing_hardware = {}
			local detected_hardware = {}
			for _, class in ipairs(required) do
				if hardware.classes[class] then
					detected_hardware[#detected_hardware + 1] = class
				else
					missing_hardware[#missing_hardware + 1] = class
				end
			end
			local state
			if not software_installed then
				state = "UNAVAILABLE"
			elseif #missing_hardware > 0 then
				state = manifest.no_device_state == "READY / NO DEVICE" and "READY / NO DEVICE" or "HARDWARE REQUIRED"
			elseif manifest.enabled == true then
				state = "READY"
			else
				state = "NOT CONFIGURED"
			end
			local probe = type(manifest.status_probe) == "string" and manifest.status_probe or "software"
			if not valid_probe_ids[probe] then probe = "software" end
			local action_ready = state == "READY"
			local readiness_reason = state
			if manifest.id == "gps-gnss" and manifest.enabled == true then
				action_ready = hardware.gps.ready
				readiness_reason = hardware.gps.reason
				if software_installed and #missing_hardware == 0 and not action_ready then state = "NOT CONFIGURED" end
			end
			modules[#modules + 1] = {
				id = manifest.id,
				name = manifest.name,
				category = manifest.category,
				description = manifest.description or "",
				package_names = package_names,
				expected_binaries = binaries,
				required_hardware = required,
				status_probe = probe,
				risk_level = manifest.risk_level or "INFO",
				console_enabled = manifest.enabled == true,
				action_ready = action_ready,
				readiness_reason = readiness_reason,
				actions = type(manifest.actions) == "table" and manifest.actions or {},
				help_text = manifest.help_text or "",
				software = {
					installed = software_installed,
					matched_packages = matched_packages,
					matched_binaries = matched_binaries
				},
				hardware = {
					required = #required > 0,
					present = #missing_hardware == 0,
					detected = detected_hardware,
					missing = missing_hardware
				},
				state = state
			}
		end
	end
	return modules
end

local info_actions = {
	["system.refresh"] = { label = "System Status", command = "uname -a; uptime; free; df -h /" },
	["network.interfaces"] = { label = "Interfaces", command = "ip -o link show; ip -o addr show" },
	["network.routes"] = { label = "Routes", command = "ip route show; ip -6 route show" },
	["hardware.usb"] = { label = "USB Devices", command = "lsusb" },
	["hardware.serial"] = { label = "Serial Device Attribution", render = serial_attribution_text },
	["serial.inspect"] = { label = "Serial Device Attribution", render = serial_attribution_text },
	["remote.tailscale"] = { label = "Tailscale Status", command = "tailscale version; tailscale ip -4; pidof tailscaled >/dev/null && echo 'tailscaled: running' || echo 'tailscaled: not running'" },
	["storage.mounts"] = { label = "Storage and Mounts", command = "df -hT; printf '\\nMounts:\\n'; mount" },
	["system.memory"] = { label = "Memory and Swap", command = "free; printf '\\n/proc/swaps:\\n'; cat /proc/swaps" },
	["packages.count"] = { label = "Installed Package Count", command = "opkg list-installed | wc -l" }
}

local function valid_job_id(value)
	return type(value) == "string" and value:match("^job%-%d+%-%d+$") ~= nil
end

local function valid_report_id(value)
	return type(value) == "string" and value:match("^report%-%d+%-%d+$") ~= nil
end

local function remove_tree(path)
	if not path:match("^/tmp/ddk/jobs/job%-%d+%-%d+$") then return false end
	local iterator = fs.dir(path)
	if iterator then
		for name in iterator do
			if name ~= "." and name ~= ".." then
				local child = path .. "/" .. name
				local stat = fs.stat(child)
				if stat and stat.type == "dir" then remove_tree(child) else fs.unlink(child) end
			end
		end
	end
	fs.rmdir(path)
	return true
end

local function job_state(job_id)
	local base = JOB_ROOT .. "/" .. job_id
	local status = trim(fs.readfile(base .. "/status"))
	if status == "" then return nil end
	local stdout, stdout_truncated = read_limited(base .. "/stdout", MAX_CAPTURE)
	local stderr, stderr_truncated = read_limited(base .. "/stderr", MAX_STDERR)
	local metadata = parse_json(fs.readfile(base .. "/metadata.json")) or {}
	local artifact
	if status == "complete" and metadata.action_id == "camera.still_snapshot" then
		local artifact_path = base .. "/snapshot.jpg"
		local artifact_stat = fs.lstat(artifact_path)
		if artifact_stat and artifact_stat.type == "reg" and artifact_stat.size > 0 and
		   artifact_stat.size <= MAX_CAMERA_ARTIFACT then
			local handle = io.open(artifact_path, "rb")
			local magic = handle and handle:read(3) or ""
			if handle then handle:close() end
			if magic == string.char(255, 216, 255) then
				artifact = {
					kind = "camera_snapshot",
					filename = "ddk-camera-" .. job_id .. ".jpg",
					content_type = "image/jpeg",
					size = artifact_stat.size
				}
			end
		end
	end
	return {
		id = job_id,
		status = status,
		pid = tonumber(trim(fs.readfile(base .. "/pid"))),
		metadata = metadata,
		artifact = artifact,
		stdout = stdout or "",
		stderr = stderr or "",
		stdout_truncated = stdout_truncated,
		stderr_truncated = stderr_truncated
	}
end

local function cleanup_transient()
	local now = os.time()
	local retained = {}
	local iterator = fs.dir(JOB_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) then
				local path = JOB_ROOT .. "/" .. name
				local stat = fs.stat(path)
				local state = trim(fs.readfile(path .. "/status"))
				local active = state == "queued" or state == "running" or state == "stopping"
				local mtime = stat and stat.mtime or now
				if not active and now - mtime > JOB_MAX_AGE then
					remove_tree(path)
				else
					retained[#retained + 1] = { name = name, mtime = mtime, active = active }
				end
			end
		end
	end
	table.sort(retained, function(a, b) return a.mtime > b.mtime end)
	for index = MAX_RETAINED_JOBS + 1, #retained do
		if not retained[index].active then remove_tree(JOB_ROOT .. "/" .. retained[index].name) end
	end

	iterator = fs.dir(REPORT_ROOT)
	if iterator then
		for name in iterator do
			local report_id = name:match("^(report%-%d+%-%d+)%.txt$")
			if report_id then
				local path = REPORT_ROOT .. "/" .. name
				local stat = fs.stat(path)
				if stat and now - (stat.mtime or now) > REPORT_MAX_AGE then fs.unlink(path) end
			end
		end
	end
end

