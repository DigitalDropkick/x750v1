local function backend_allows_executable(backend, executable)
	if type(backend) ~= "table" or type(executable) ~= "string" then return false end
	if backend.executable == executable then return true end
	for _, allowed in ipairs(backend.executables or {}) do if allowed == executable then return true end end
	return false
end

local function prepare_operator_action(action_id, encoded)
	local options, err = parse_operator_envelope(encoded)
	if not options then return nil, err end
	local plan
	local module = operator_module_for(action_id)
	plan, err = module.prepare(action_id, options, operator_context(action_id))
	if not plan then return nil, err end
	local backend = operator_backends[action_id]
	if not backend or plan.action_id ~= action_id or plan.worker ~= backend.worker or
	   type(plan.argv) ~= "table" or not backend_allows_executable(backend, plan.argv[1]) or not binary_exists(plan.argv[1]) then
		return nil, "Operator action builder produced an invalid native execution plan"
	end
	if backend.decode_executable and not binary_exists(backend.decode_executable) then return nil, "The exact native decoder executable is unavailable" end
	for _, argument in ipairs(plan.argv) do
		if type(argument) ~= "string" or argument == "" or argument:find("[%z\r\n]") then
			return nil, "Operator action builder produced an invalid argv element"
		end
	end
	if type(plan.artifacts) ~= "table" then return nil, "Operator action builder did not declare an artifact list" end
	local artifact_names, artifact_count = {}, 0
	for index, artifact in ipairs(plan.artifacts) do
		artifact_count = index
		local name = type(artifact) == "table" and artifact.name or nil
		local maximum = type(artifact) == "table" and tonumber(artifact.max_size) or nil
		local storage = type(artifact) == "table" and (artifact.storage or "tmp") or nil
		if type(name) ~= "string" or not name:match("^[A-Za-z0-9][A-Za-z0-9_.-]+$") or name:find("..", 1, true) or
		   artifact_names[name] or not maximum or maximum ~= math.floor(maximum) or maximum < 1 or maximum > MAX_OPERATOR_ARTIFACT or
		   (storage ~= "tmp" and storage ~= "extroot") or (storage == "tmp" and maximum > MAX_TMP_OPERATOR_ARTIFACT) or
		   type(artifact.kind) ~= "string" or not artifact.kind:match("^[A-Za-z0-9_.-]+$") or
		   type(artifact.content_type) ~= "string" or not artifact.content_type:match("^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$") then
			return nil, "Operator action builder declared an invalid artifact"
		end
		artifact.storage = storage
		artifact_names[name] = true
	end
	for key in pairs(plan.artifacts) do
		if type(key) ~= "number" or key < 1 or key > artifact_count or key ~= math.floor(key) then
			return nil, "Operator action artifact list is not dense"
		end
	end
	local workspace_names, workspace_count = {}, 0
	if plan.workspaces ~= nil and type(plan.workspaces) ~= "table" then return nil, "Operator action builder declared an invalid workspace list" end
	for index, workspace in ipairs(plan.workspaces or {}) do
		workspace_count = index
		local name = type(workspace) == "table" and workspace.name or nil
		local storage = type(workspace) == "table" and workspace.storage or nil
		local reserve = type(workspace) == "table" and tonumber(workspace.reserve_size) or nil
		if index > 2 or type(name) ~= "string" or not name:match("^[A-Za-z0-9][A-Za-z0-9-]+$") or workspace_names[name] or
		   storage ~= "extroot" or not reserve or reserve ~= math.floor(reserve) or reserve < 1048576 or reserve > MAX_OPERATOR_WORKSPACE_RESERVE then
			return nil, "Operator action builder declared an invalid isolated workspace"
		end
		workspace_names[name] = true
	end
	for key in pairs(plan.workspaces or {}) do
		if type(key) ~= "number" or key < 1 or key > workspace_count or key ~= math.floor(key) then return nil, "Operator action workspace list is not dense" end
	end
	local validated_uploads, upload_count, seen_uploads = {}, 0, {}
	if plan.input_uploads ~= nil and type(plan.input_uploads) ~= "table" then
		return nil, "Operator action builder declared an invalid input upload list"
	end
	for index, declaration in ipairs(plan.input_uploads or {}) do
		upload_count = index
		if index > 4 or type(declaration) ~= "table" or not valid_upload_id(declaration.id) or
		   type(declaration.kind) ~= "string" or not upload_policies[declaration.kind] or seen_uploads[declaration.id] then
			return nil, "Operator action builder declared an invalid input upload"
		end
		local upload, upload_error = sealed_upload_record(declaration.id, declaration.kind)
		if not upload then return nil, upload_error end
		seen_uploads[declaration.id] = true
		validated_uploads[#validated_uploads + 1] = upload
	end
	for key in pairs(plan.input_uploads or {}) do
		if type(key) ~= "number" or key < 1 or key > upload_count or key ~= math.floor(key) then
			return nil, "Operator action input upload list is not dense"
		end
	end
	plan.input_uploads = validated_uploads
	if plan.private_input_hex ~= nil and
	   (type(plan.private_input_hex) ~= "string" or #plan.private_input_hex == 0 or #plan.private_input_hex > 8192 or
	    #plan.private_input_hex % 2 ~= 0 or plan.private_input_hex:find("[^0-9a-f]")) then
		return nil, "Operator action builder produced invalid private input"
	end
	local private_input_count, private_input_bytes, private_input_names = 0, 0, {}
	if plan.private_inputs ~= nil and type(plan.private_inputs) ~= "table" then return nil, "Operator action builder produced an invalid private input list" end
	for index, private_input in ipairs(plan.private_inputs or {}) do
		private_input_count = index
		local name = type(private_input) == "table" and private_input.name or nil
		local encoded = type(private_input) == "table" and private_input.hex or nil
		if index > 4 or type(name) ~= "string" or not name:match("^[a-z][a-z0-9-]+$") or #name > 32 or private_input_names[name] or
		   type(encoded) ~= "string" or #encoded < 2 or #encoded > 16384 or #encoded % 2 ~= 0 or encoded:find("[^0-9a-f]") then
			return nil, "Operator action builder produced an invalid named private input"
		end
		private_input_names[name] = true
		private_input_bytes = private_input_bytes + #encoded / 2
	end
	for key in pairs(plan.private_inputs or {}) do
		if type(key) ~= "number" or key < 1 or key > private_input_count or key ~= math.floor(key) then return nil, "Operator action private input list is not dense" end
	end
	if private_input_bytes > 16384 then return nil, "Operator action private inputs exceed the 16 KiB request boundary" end
	if plan.decode_argv ~= nil then
		if type(plan.decode_argv) ~= "table" or plan.decode_argv[1] ~= (backend.decode_executable or backend.executable) then
			return nil, "Operator action builder produced an invalid decode argv"
		end
		for _, argument in ipairs(plan.decode_argv) do
			if type(argument) ~= "string" or argument == "" or argument:find("[%z\r\n]") then
				return nil, "Operator action builder produced an invalid decode argv element"
			end
		end
	end
	plan.created_at = os.time()
	plan.expires_at = plan.created_at + PREPARED_MAX_AGE
	fs.mkdirr(PREPARED_ROOT)
	fs.chmod("/tmp/ddk", "0700")
	fs.chmod(PREPARED_ROOT, "0700")
	cleanup_prepared()
	local prepared_id, prepared_path
	for counter = 1, 100 do
		prepared_id = string.format("prep-%d-%d-%d", plan.created_at, nixio.getpid(), counter)
		prepared_path = PREPARED_ROOT .. "/" .. prepared_id
		if not fs.stat(prepared_path) and fs.mkdir(prepared_path, "0700") then break end
		prepared_id, prepared_path = nil, nil
	end
	if not prepared_id then return nil, "Unable to allocate a prepared action request" end
	local encoded_plan = json.stringify(plan)
	if not encoded_plan or not write_file(prepared_path .. "/plan.json", encoded_plan .. "\n") then
		remove_prepared_tree(prepared_path)
		return nil, "Unable to persist the prepared action request"
	end
	fs.chmod(prepared_path .. "/plan.json", "0600")
	return {
		prepared_id = prepared_id,
		expires_at = plan.expires_at,
		action_id = plan.action_id,
		label = plan.label,
		class = plan.class,
		normalized_options = plan.options,
		target_summary = plan.target_summary,
		argv_preview = plan.argv_preview,
		wall_timeout = plan.wall_timeout,
		artifacts = plan.artifacts,
		workspaces = plan.workspaces or {},
		input_uploads = (function()
			local result = {}
			for _, upload in ipairs(plan.input_uploads or {}) do
				result[#result + 1] = { id = upload.id, kind = upload.kind, original_name = upload.original_name, size = upload.size, sha256 = upload.sha256, expires_at = upload.expires_at }
			end
			return result
		end)(),
		confirmation = plan.confirmation
	}
end

local function claim_prepared_action(prepared_id, encoded_confirmation)
	if not valid_prepared_id(prepared_id) then return nil, nil, "Invalid prepared action ID" end
	cleanup_prepared()
	local path = PREPARED_ROOT .. "/" .. prepared_id
	local claim_path = path .. ".claim-" .. tostring(nixio.getpid())
	if not fs.rename(path, claim_path) then return nil, nil, "Prepared action was not found, expired, or already claimed" end
	local plan = parse_json(fs.readfile(claim_path .. "/plan.json"))
	if type(plan) ~= "table" or plan.action_id == nil or plan.expires_at == nil or plan.expires_at < os.time() then
		remove_prepared_tree(claim_path)
		return nil, nil, "Prepared action is invalid or expired"
	end
	local confirmation = type(plan.confirmation) == "table" and plan.confirmation or {}
	if confirmation.required then
		local supplied, err = base64url_decode(encoded_confirmation)
		if not supplied or supplied ~= confirmation.phrase then
			remove_prepared_tree(claim_path)
			return nil, nil, err or "The target-bound confirmation phrase did not match"
		end
	elseif encoded_confirmation ~= nil then
		remove_prepared_tree(claim_path)
		return nil, nil, "This action does not accept a confirmation value"
	end
	return plan, claim_path
end

local function remove_owned_tree(root, path)
	if path ~= root and path:sub(1, #root + 1) ~= root .. "/" then return false end
	local stat = fs.lstat(path)
	if not stat then return true end
	if stat.type ~= "dir" then fs.unlink(path); return true end
	local iterator = fs.dir(path)
	if iterator then
		for name in iterator do
			if name ~= "." and name ~= ".." then remove_owned_tree(root, path .. "/" .. name) end
		end
	end
	fs.rmdir(path)
	return fs.lstat(path) == nil
end

local function remove_artifact_tree(job_id)
	if not valid_job_id(job_id) then return false end
	local root = ARTIFACT_ROOT .. "/" .. job_id
	return remove_owned_tree(root, root)
end

local function remove_tree(path)
	local job_id = path:match("^/tmp/ddk/jobs/(job%-%d+%-%d+)$")
	if not job_id then return false end
	local removed = remove_owned_tree(path, path)
	remove_artifact_tree(job_id)
	return removed
end

local function job_state(job_id)
	local base = JOB_ROOT .. "/" .. job_id
	local status = trim(fs.readfile(base .. "/status"))
	if status == "" then return nil end
	local stdout, stdout_truncated = read_limited(base .. "/stdout", MAX_CAPTURE)
	local stderr, stderr_truncated = read_limited(base .. "/stderr", MAX_STDERR)
	local metadata = parse_json(fs.readfile(base .. "/metadata.json")) or {}
	local artifact
	local artifacts = {}
	if status == "complete" and metadata.action_id == "camera.still_snapshot" and metadata.operator_mode ~= true then
		local artifact_path = base .. "/snapshot.jpg"
		local artifact_stat = fs.lstat(artifact_path)
		if artifact_stat and artifact_stat.type == "reg" and artifact_stat.size > 0 and
		   artifact_stat.size <= MAX_CAMERA_ARTIFACT then
			local handle = io.open(artifact_path, "rb")
			local magic = handle and handle:read(3) or ""
			if handle then handle:close() end
			if magic == string.char(255, 216, 255) then
				artifact = {
					kind = "camera_snapshot",
					filename = "ddk-camera-" .. job_id .. ".jpg",
					content_type = "image/jpeg",
					size = artifact_stat.size
				}
			end
		end
	end
	if status == "complete" and type(metadata.artifacts) == "table" then
		for _, definition in ipairs(metadata.artifacts) do
			local name = type(definition) == "table" and definition.name or ""
			local maximum = type(definition) == "table" and tonumber(definition.max_size) or 0
			local storage = type(definition) == "table" and (definition.storage or "tmp") or "tmp"
			if name:match("^[A-Za-z0-9][A-Za-z0-9_.-]+$") and not name:find("..", 1, true) and
			   maximum and maximum > 0 and maximum <= MAX_OPERATOR_ARTIFACT and
			   (storage == "tmp" or storage == "extroot") then
				local path = (storage == "extroot" and (ARTIFACT_ROOT .. "/" .. job_id) or base) .. "/" .. name
				local stat = fs.lstat(path)
				if stat and stat.type == "reg" and stat.size > 0 and stat.size <= maximum then
					artifacts[#artifacts + 1] = {
						name = name,
						kind = definition.kind or "operator_artifact",
						storage = storage,
						filename = "ddk-" .. job_id .. "-" .. name,
						content_type = definition.content_type or "application/octet-stream",
						size = stat.size
					}
				end
			end
		end
	end
	return {
		id = job_id,
		status = status,
		pid = tonumber(trim(fs.readfile(base .. "/pid"))),
		metadata = metadata,
		artifact = artifact,
		artifacts = artifacts,
		stdout = stdout or "",
		stderr = stderr or "",
		stdout_truncated = stdout_truncated,
		stderr_truncated = stderr_truncated
	}
end

local function job_process_active(job_id)
	if not valid_job_id(job_id) then return false end
	local base = JOB_ROOT .. "/" .. job_id
	local status = trim(fs.readfile(base .. "/status"))
	if status ~= "queued" and status ~= "running" and status ~= "stopping" then return false end
	local pid = tonumber(trim(fs.readfile(base .. "/pid")))
	if not pid or pid < 2 then
		local stat = fs.stat(base)
		return status == "queued" and stat ~= nil and os.time() - (stat.mtime or 0) <= 30
	end
	local cmdline = (fs.readfile("/proc/" .. pid .. "/cmdline") or ""):gsub("%z", " ")
	return (cmdline:find(DEFAULT_JOB_WORKER, 1, true) ~= nil or cmdline:find(APPLE_JOB_WORKER, 1, true) ~= nil or cmdline:find(PHASE3_JOB_WORKER, 1, true) ~= nil or cmdline:find(PHASE4_JOB_WORKER, 1, true) ~= nil) and cmdline:find(job_id, 1, true) ~= nil
end

local function cleanup_transient()
	cleanup_prepared()
	local now = os.time()
	local retained = {}
	local iterator = fs.dir(JOB_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) then
				local path = JOB_ROOT .. "/" .. name
				local stat = fs.stat(path)
				local state = trim(fs.readfile(path .. "/status"))
				local declared_active = state == "queued" or state == "running" or state == "stopping"
				local active = declared_active and job_process_active(name)
				if declared_active and not active then
					write_file(path .. "/status", "failed\n")
					local handle = io.open(path .. "/stderr", "ab")
					if handle then handle:write("The recorded DDK worker is no longer active; stale job state was recovered.\n"); handle:close() end
				end
				local mtime = stat and stat.mtime or now
				if not active and now - mtime > JOB_MAX_AGE then
					remove_tree(path)
				else
					retained[#retained + 1] = { name = name, mtime = mtime, active = active }
				end
			end
		end
	end
	table.sort(retained, function(a, b) return a.mtime > b.mtime end)
	for index = MAX_RETAINED_JOBS + 1, #retained do
		if not retained[index].active then remove_tree(JOB_ROOT .. "/" .. retained[index].name) end
	end

	iterator = fs.dir(ARTIFACT_ROOT)
	if iterator then
		for name in iterator do
			if valid_job_id(name) and not fs.lstat(JOB_ROOT .. "/" .. name) then remove_artifact_tree(name) end
		end
	end

	iterator = fs.dir(REPORT_ROOT)
	if iterator then
		for name in iterator do
			local report_id = name:match("^(report%-%d+%-%d+)%.txt$")
			if report_id then
				local path = REPORT_ROOT .. "/" .. name
				local stat = fs.stat(path)
				if stat and now - (stat.mtime or now) > REPORT_MAX_AGE then fs.unlink(path) end
			end
		end
	end
end

