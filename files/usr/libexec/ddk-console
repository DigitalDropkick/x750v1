#!/usr/bin/lua

-- Digital Dropkick Field Console backend.
-- Browser input selects exact allowlist entries; it never becomes shell syntax.

local fs = require "nixio.fs"
local json = require "luci.jsonc"
local nixio = require "nixio"
local usb_identity = dofile("/usr/share/ddk-field-console/usb-identity.lua")
local operator_actions = dofile("/usr/share/ddk-field-console/operator-actions.lua")
local operator_apple = dofile("/usr/share/ddk-field-console/operator-apple.lua")
local operator_phase3 = dofile("/usr/share/ddk-field-console/operator-phase3.lua")
local operator_phase4 = dofile("/usr/share/ddk-field-console/operator-phase4.lua")

local TOOL_ROOT = "/usr/share/ddk-field-console/tools"
local JOB_ROOT = "/tmp/ddk/jobs"
local REPORT_ROOT = "/tmp/ddk/reports"
local PREPARED_ROOT = "/tmp/ddk/prepared"
local LOCK_ROOT = "/tmp/ddk/locks"
local UPLOAD_PARENT = "/overlay/ddk-field-console"
local UPLOAD_ROOT = UPLOAD_PARENT .. "/uploads"
local ARTIFACT_ROOT = UPLOAD_PARENT .. "/artifacts"
local MAX_CAPTURE = 131072
local MAX_STDERR = 32768
local MAX_CAMERA_ARTIFACT = 262144
local MAX_OPERATOR_ENVELOPE = 24576
local MAX_OPERATOR_ARTIFACT = 17179869184
local MAX_TMP_OPERATOR_ARTIFACT = 16777216
local MAX_OPERATOR_WORKSPACE_RESERVE = 17179869184
local MIN_OVERLAY_RESERVE = 104857600
local MAX_ACTIVE_JOBS = 2
local MAX_RETAINED_JOBS = 20
local JOB_MAX_AGE = 4 * 60 * 60
local REPORT_MAX_AGE = 24 * 60 * 60
local PREPARED_MAX_AGE = 5 * 60
local RESERVED_UPLOAD_MAX_AGE = 60 * 60
local SEALED_UPLOAD_MAX_AGE = 24 * 60 * 60
local MAX_RETAINED_UPLOADS = 10
local USB_SYSFS_ROOT = "/sys/bus/usb/devices"
local DEFAULT_JOB_WORKER = "/usr/libexec/ddk-job-worker"
local APPLE_JOB_WORKER = "/usr/libexec/ddk-apple-worker"
local PHASE3_JOB_WORKER = "/usr/libexec/ddk-phase3-worker"
local PHASE4_JOB_WORKER = "/usr/libexec/ddk-phase4-worker"

local function trim(value)
	return (tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", ""))
end

local function respond(ok, data, message, code)
	io.write(json.stringify({
		ok = ok and true or false,
		data = data,
		message = message,
		code = code
	}) or '{"ok":false,"message":"JSON encoding failed"}')
	io.write("\n")
	os.exit(ok and 0 or 1)
end

local function read_limited(path, limit)
	local handle = io.open(path, "rb")
	if not handle then
		return nil, false
	end
	local value = handle:read(limit or MAX_CAPTURE) or ""
	local extra = handle:read(1)
	handle:close()
	return value, extra ~= nil
end

local function write_file(path, value)
	local handle = io.open(path, "wb")
	if not handle then
		return false
	end
	handle:write(value or "")
	handle:close()
	return true
end

local function shell_quote(value)
	return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function capture(command, limit, timeout_seconds)
	-- Callers pass source-code constants or paths composed only from strict server-side identifiers.
	local timeout_value = tonumber(timeout_seconds) or 12
	if timeout_value < 1 or timeout_value > 1800 or timeout_value ~= math.floor(timeout_value) then timeout_value = 12 end
	local handle = io.popen("LC_ALL=C timeout " .. tostring(timeout_value) .. " sh -c " .. shell_quote(command) .. " 2>&1")
	if not handle then
		return "", false
	end
	local chunks = {}
	local total = 0
	local cap = limit or MAX_CAPTURE
	local truncated = false
	while total < cap do
		local chunk = handle:read(math.min(4096, cap - total))
		if not chunk then
			break
		end
		chunks[#chunks + 1] = chunk
		total = total + #chunk
	end
	if total >= cap then
		-- Drain without retaining so a verbose child cannot block in pclose().
		while true do
			local discarded = handle:read(4096)
			if not discarded then break end
			truncated = true
		end
	end
	handle:close()
	return table.concat(chunks), truncated
end

local function parse_json(value)
	if not value or value == "" then
		return nil
	end
	local ok, parsed = pcall(json.parse, value)
	return ok and parsed or nil
end

local function base64url_decode(value)
	if type(value) ~= "string" or value == "" or #value > math.ceil(MAX_OPERATOR_ENVELOPE * 4 / 3) + 4 or
	   value:find("[^A-Za-z0-9_-]") then
		return nil, "Structured payload is not valid base64url"
	end
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local input = value:gsub("-", "+"):gsub("_", "/")
	local remainder = #input % 4
	if remainder == 1 then return nil, "Structured payload has invalid base64url length" end
	if remainder > 0 then input = input .. string.rep("=", 4 - remainder) end
	local output, accumulator, bits = {}, 0, 0
	for index = 1, #input do
		local character = input:sub(index, index)
		if character == "=" then break end
		local position = alphabet:find(character, 1, true)
		if not position then return nil, "Structured payload contains invalid base64url data" end
		accumulator = accumulator * 64 + position - 1
		bits = bits + 6
		if bits >= 8 then
			bits = bits - 8
			output[#output + 1] = string.char(math.floor(accumulator / (2 ^ bits)) % 256)
			accumulator = accumulator % (2 ^ bits)
			if #output > MAX_OPERATOR_ENVELOPE then return nil, "Structured payload exceeds the 24 KiB limit" end
		end
	end
	return table.concat(output)
end

local function parse_operator_envelope(encoded)
	local decoded, err = base64url_decode(encoded)
	if not decoded then return nil, err end
	local envelope = parse_json(decoded)
	if type(envelope) ~= "table" then return nil, "Structured payload must decode to a JSON object" end
	for key in pairs(envelope) do
		if key ~= "version" and key ~= "options" then return nil, "Unknown structured envelope field: " .. tostring(key) end
	end
	if envelope.version ~= 1 then return nil, "Unsupported structured action envelope version" end
	if type(envelope.options) ~= "table" then return nil, "Structured action options must be a JSON object" end
	return envelope.options
end

local function release_value(name)
	local body = fs.readfile("/etc/openwrt_release") or ""
	return body:match(name .. "='([^']*)'") or ""
end

local function meminfo()
	local values = {}
	for line in (fs.readfile("/proc/meminfo") or ""):gmatch("[^\n]+") do
		local key, number = line:match("^([^:]+):%s*(%d+)")
		if key and number then
			values[key] = tonumber(number) * 1024
		end
	end
	return values
end

local package_cache
local package_map_cache

local function package_inventory()
	if package_cache then
		return package_cache, package_map_cache
	end

	local packages = {}
	local package_map = {}
	local body = (fs.readfile("/usr/lib/opkg/status") or "") .. "\n\n"
	for paragraph in body:gmatch("(.-)\n\n") do
		local name = paragraph:match("\n?Package:%s*([^\n]+)")
		local version = paragraph:match("\nVersion:%s*([^\n]+)")
		local status = paragraph:match("\nStatus:%s*([^\n]+)")
		status = trim(status)
		if name and status:match("^%S+%s+%S+%s+installed$") then
			name = trim(name)
			if not package_map[name] then
				package_map[name] = true
				packages[#packages + 1] = {
					name = name,
					version = trim(version),
					category = false
				}
			end
		end
	end

	local function classify(name)
		local lower = name:lower()
		if lower:match("^luci%-") then
			return "LuCI"
		elseif lower:match("^kmod%-") or lower:match("^kernel") then
			return "Kernel"
		elseif lower:match("^python") or lower:match("^python3%-") then
			return "Python"
		elseif lower:match("^lib") or lower:match("%-libs?$") then
			return "Libraries"
		elseif lower:match("collectd") or lower:match("prometheus") or lower:match("vnstat") or
		       lower:match("nlbw") or lower:match("rrd") or lower == "bmon" or
		       lower == "iftop" or lower == "htop" then
			return "Monitoring"
		elseif lower:match("usb") or lower:match("serial") or lower:match("bluetooth") or
		       lower:match("gps") or lower:match("rtl") or lower:match("sdr") or
		       lower:match("modbus") or lower:match("pcsc") or lower:match("fido") or
		       lower:match("yubi") or lower:match("camera") or lower:match("mjpg") or
		       lower:match("v4l") or lower:match("adb") or lower:match("imobile") or
		       lower:match("flashrom") or lower:match("openocd") or lower:match("avrdude") or
		       lower:match("dfu") or lower:match("canutils") then
			return "Hardware"
		elseif lower:match("nmap") or lower:match("network") or lower:match("netif") or
		       lower:match("tcp") or lower:match("wifi") or lower:match("wireless") or
		       lower:match("dns") or lower:match("dhcp") or lower:match("snmp") or
		       lower:match("tailscale") or lower:match("vpn") or lower:match("firewall") or
		       lower:match("iproute") or lower:match("arp%-") then
			return "Networking"
		end
		return "Applications"
	end

	for _, item in ipairs(packages) do
		item.category = classify(item.name)
	end
	table.sort(packages, function(a, b) return a.name < b.name end)
	package_cache = packages
	package_map_cache = package_map
	return packages, package_map
end

local function binary_exists(name)
	if type(name) ~= "string" or not name:match("^[A-Za-z0-9_+%.%-/]+$") then
		return false
	end
	if name:sub(1, 1) == "/" then
		return fs.access(name, "x") and true or false
	end
	for _, prefix in ipairs({ "/usr/bin/", "/usr/sbin/", "/bin/", "/sbin/" }) do
		if fs.access(prefix .. name, "x") then
			return true
		end
	end
	return false
end

local function list_device_nodes(pattern)
	local result = {}
	local iterator = fs.dir("/dev")
	if iterator then
		for name in iterator do
			if name:match(pattern) then
				result[#result + 1] = "/dev/" .. name
			end
		end
	end
	table.sort(result)
	return result
end

local function interface_list()
	local output = capture("ip -o link show")
	local result = {}
	for line in output:gmatch("[^\n]+") do
		local name = line:match("^%d+:%s+([^:]+):")
		if name then
			result[#result + 1] = {
				name = name:gsub("@.*$", ""),
				state = line:match("%sstate%s+(%S+)") or "UNKNOWN"
			}
		end
	end
	return result
end

local function usb_lines()
	local output = binary_exists("lsusb") and capture("lsusb") or ""
	local lines = {}
	for line in output:gmatch("[^\n]+") do
		if trim(line) ~= "" then
			lines[#lines + 1] = trim(line)
		end
	end
	return lines, output:lower()
end

local function has_dir_entry(path, pattern)
	local iterator = fs.dir(path)
	if not iterator then
		return false
	end
	for name in iterator do
		if name:match(pattern) then
			return true
		end
	end
	return false
end

local function rtl_sdr_probe()
	local probe = {
		accepted_usb_ids = { "0bda:2832", "0bda:2838" },
		reviewed_count = 0,
		devices = {},
		ready = false,
		reason = "REVIEWED HARDWARE NOT DETECTED"
	}
	local iterator = fs.dir("/sys/bus/usb/devices")
	if iterator then
		for name in iterator do
			local base = "/sys/bus/usb/devices/" .. name
			local vendor_id = trim(fs.readfile(base .. "/idVendor")):lower()
			local product_id = trim(fs.readfile(base .. "/idProduct")):lower()
			if vendor_id == "0bda" and (product_id == "2832" or product_id == "2838") then
				probe.reviewed_count = probe.reviewed_count + 1
				local serial = trim(fs.readfile(base .. "/serial"))
				local serial_valid = #serial > 0 and #serial <= 64 and serial:match("^[A-Za-z0-9_.%-]+$") ~= nil
				local claimed_driver = ""
				local interface_iterator = fs.dir("/sys/bus/usb/devices")
				if interface_iterator then
					for interface_name in interface_iterator do
						if interface_name:sub(1, #name + 1) == name .. ":" then
							local driver_link = fs.readlink("/sys/bus/usb/devices/" .. interface_name .. "/driver") or ""
							if driver_link ~= "" then claimed_driver = driver_link:match("([^/]+)$") or "claimed" end
						end
					end
				end
				local candidate = {
					usb_id = vendor_id .. ":" .. product_id,
					serial = serial,
					selector = ":" .. serial,
					serial_valid = serial_valid,
					claimed_driver = claimed_driver,
					label = (vendor_id .. ":" .. product_id) .. " / serial " .. (serial_valid and serial or "unavailable")
				}
				if serial_valid and claimed_driver == "" then probe.devices[#probe.devices + 1] = candidate end
			end
		end
	end
	table.sort(probe.devices, function(a, b) return a.selector < b.selector end)
	if #probe.devices > 0 then
		probe.ready = true
		probe.reason = string.format("READY - %d REVIEWED DONGLE%s SELECTABLE", #probe.devices, #probe.devices == 1 and "" or "S")
	elseif probe.reviewed_count > 0 then
		probe.reason = "REVIEWED DONGLE PRESENT BUT SERIAL OR DRIVER OWNERSHIP IS UNSAFE"
	end
	return probe
end

local function camera_probe()
	local probe = {
		ready = false,
		reason = "REVIEWED UVC CAMERA NOT DETECTED",
		reviewed_device_count = 0,
		reviewed_node_count = 0,
		primary_node_count = 0,
		nodes = {}
	}
	local usb_devices = {}
	local primary_nodes = {}
	local iterator = fs.dir("/sys/class/video4linux")
	if iterator then
		for name in iterator do
			if name:match("^video%d+$") then
				local node = "/dev/" .. name
				local node_stat = fs.stat(node)
				local class_base = "/sys/class/video4linux/" .. name
				local device_path = fs.realpath(class_base .. "/device") or ""
				local usb_parent = device_path ~= "" and (fs.realpath(device_path .. "/..") or "") or ""
				local driver_link = device_path ~= "" and (fs.readlink(device_path .. "/driver") or "") or ""
				local driver = driver_link:match("([^/]+)$") or ""
				local interface_class = trim(fs.readfile(device_path .. "/bInterfaceClass")):lower()
				local vendor_id = trim(fs.readfile(usb_parent .. "/idVendor")):lower()
				local product_id = trim(fs.readfile(usb_parent .. "/idProduct")):lower()
				local index = trim(fs.readfile(class_base .. "/index"))
				local reviewed = node_stat and node_stat.type == "chr" and
					device_path:match("^/sys/devices/") ~= nil and usb_parent:match("^/sys/devices/") ~= nil and
					driver == "uvcvideo" and interface_class == "0e" and
					vendor_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
					product_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil

				if reviewed then
					probe.reviewed_node_count = probe.reviewed_node_count + 1
					usb_devices[usb_parent] = true
					local candidate = {
						node = node,
						name = trim(fs.readfile(class_base .. "/name")),
						index = index,
						usb_id = vendor_id .. ":" .. product_id,
						interface_number = trim(fs.readfile(device_path .. "/bInterfaceNumber")),
						driver = driver
					}
					probe.nodes[#probe.nodes + 1] = candidate
					if index == "0" then primary_nodes[#primary_nodes + 1] = candidate end
				end
			end
		end
	end

	for _ in pairs(usb_devices) do probe.reviewed_device_count = probe.reviewed_device_count + 1 end
	probe.primary_node_count = #primary_nodes
	table.sort(probe.nodes, function(a, b) return a.node < b.node end)
	table.sort(primary_nodes, function(a, b) return a.node < b.node end)

	if probe.reviewed_device_count >= 1 and probe.reviewed_node_count > 0 then
		if #primary_nodes == 0 then
			probe.reason = "UVC PRIMARY CAPTURE NODE NOT DETECTED"
		else
			probe.ready = true
			probe.reason = string.format("READY - %d REVIEWED UVC PRIMARY NODE%s SELECTABLE", #primary_nodes, #primary_nodes == 1 and "" or "S")
			probe.device = primary_nodes[1].node
			probe.usb_id = primary_nodes[1].usb_id
			probe.name = primary_nodes[1].name
		end
	end
	return probe
end

local function device_open_by_process(device)
	if type(device) ~= "string" or
	   (not device:match("^/dev/ttyUSB%d+$") and not device:match("^/dev/ttyACM%d+$")) then
		return false
	end
	local process_iterator = fs.dir("/proc")
	if not process_iterator then return false end
	for pid in process_iterator do
		if pid:match("^%d+$") then
			local fd_iterator = fs.dir("/proc/" .. pid .. "/fd")
			if fd_iterator then
				for fd in fd_iterator do
					if fs.readlink("/proc/" .. pid .. "/fd/" .. fd) == device then
						return true
					end
				end
			end
		end
	end
	return false
end

local function gps_probe()
	local probe = {
		ready = false,
		hardware_present = false,
		reason = "REVIEWED USB GNSS RECEIVER NOT DETECTED",
		reviewed_device_count = 0,
		reviewed_node_count = 0,
		nodes = {}
	}
	local usb_devices = {}
	local candidate
	local serial_nodes = list_device_nodes("^ttyUSB%d+$")
	for _, node in ipairs(list_device_nodes("^ttyACM%d+$")) do serial_nodes[#serial_nodes + 1] = node end
	table.sort(serial_nodes)

	for _, node in ipairs(serial_nodes) do
		local name = node:match("^/dev/(.+)$") or ""
		local base = "/sys/class/tty/" .. name
		local node_stat = fs.stat(node)
		local interface_path = fs.realpath(base .. "/device/..") or ""
		local parent_path = fs.realpath(base .. "/device/../..") or ""
		local vendor_id = trim(fs.readfile(parent_path .. "/idVendor")):lower()
		local product_id = trim(fs.readfile(parent_path .. "/idProduct")):lower()
		local manufacturer = trim(fs.readfile(parent_path .. "/manufacturer"))
		local product = trim(fs.readfile(parent_path .. "/product"))
		local descriptor = (manufacturer .. " " .. product):lower()
		local driver_link = fs.readlink(interface_path .. "/driver") or ""
		local driver = driver_link:match("([^/]+)$") or ""
		local reviewed_driver = driver == "cdc_acm" or driver == "ftdi_sio" or
			driver == "cp210x" or driver == "pl2303" or driver == "ch341" or driver == "usbserial"
		local reviewed_identity = vendor_id == "1546" or descriptor:match("u%-blox") ~= nil or
			descriptor:match("ublox") ~= nil or descriptor:match("gnss") ~= nil or descriptor:match("gps") ~= nil
		local exact_ec25 = vendor_id == "2c7c" and product_id == "0125"
		local reviewed = node_stat and node_stat.type == "chr" and
			interface_path:match("^/sys/devices/") ~= nil and parent_path:match("^/sys/devices/") ~= nil and
			vendor_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
			product_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
			reviewed_driver and reviewed_identity and not exact_ec25

		if reviewed then
			usb_devices[parent_path] = true
			candidate = {
				node = node,
				usb_id = vendor_id .. ":" .. product_id,
				manufacturer = manufacturer,
				product = product,
				driver = driver,
				interface_number = trim(fs.readfile(interface_path .. "/bInterfaceNumber")),
				busy = device_open_by_process(node)
			}
			probe.nodes[#probe.nodes + 1] = candidate
		end
	end

	for _ in pairs(usb_devices) do probe.reviewed_device_count = probe.reviewed_device_count + 1 end
	probe.reviewed_node_count = #probe.nodes
	probe.hardware_present = probe.reviewed_device_count > 0
	local available = {}
	for _, item in ipairs(probe.nodes) do if not item.busy then available[#available + 1] = item end end
	probe.available_nodes = available
	if #available > 0 and binary_exists("gpsdecode") then
		candidate = available[1]
		probe.ready = true
		probe.reason = string.format("READY - %d REVIEWED GNSS NODE%s SELECTABLE", #available, #available == 1 and "" or "S")
		probe.device = candidate.node
		probe.usb_id = candidate.usb_id
		probe.driver = candidate.driver
		probe.name = trim(candidate.manufacturer .. " " .. candidate.product)
	elseif probe.reviewed_node_count > 0 and #available == 0 then
		probe.reason = "ALL REVIEWED GNSS SERIAL NODES ARE ALREADY IN USE"
	elseif probe.hardware_present and not binary_exists("gpsdecode") then
		probe.reason = "GPSDECODE EXECUTABLE IS UNAVAILABLE"
	end
	return probe
end

local function can_probe()
	local probe = {
		ready = false,
		hardware_present = false,
		capture_binary_present = binary_exists("/usr/bin/candump"),
		reason = "REVIEWED PHYSICAL CAN INTERFACE NOT DETECTED",
		reviewed_count = 0,
		interfaces = {}
	}
	local iterator = fs.dir("/sys/class/net")
	local candidate
	if iterator then
		for name in iterator do
			if name:match("^can%d+$") then
				local base = "/sys/class/net/" .. name
				local device_path = fs.realpath(base .. "/device") or ""
				local network_type = trim(fs.readfile(base .. "/type"))
				local flags_text = trim(fs.readfile(base .. "/flags"))
				local flags = tonumber(flags_text)
				local reviewed = network_type == "280" and device_path:match("^/sys/devices/") ~= nil and flags ~= nil
				if reviewed then
					candidate = {
						name = name,
						operstate = trim(fs.readfile(base .. "/operstate")),
						flags = flags_text,
						up = flags % 2 == 1,
						device_path = device_path
					}
					probe.interfaces[#probe.interfaces + 1] = candidate
				end
			end
		end
	end
	table.sort(probe.interfaces, function(a, b) return a.name < b.name end)
	probe.reviewed_count = #probe.interfaces
	probe.hardware_present = probe.reviewed_count > 0

	if probe.reviewed_count == 0 then
		if not probe.capture_binary_present then
			probe.reason = "CAN INTERFACE NOT DETECTED; CANDUMP EXECUTABLE UNAVAILABLE"
		end
	elseif probe.reviewed_count > 1 then
		probe.reason = "MULTIPLE REVIEWED PHYSICAL CAN INTERFACES DETECTED"
	elseif not probe.capture_binary_present then
		probe.reason = "CANDUMP EXECUTABLE UNAVAILABLE"
	elseif candidate and not candidate.up then
		probe.reason = "REVIEWED CAN INTERFACE IS DOWN; CONSOLE WILL NOT CONFIGURE IT"
	elseif candidate then
		probe.ready = true
		probe.reason = "READY - ONE UP PHYSICAL CAN INTERFACE"
		probe.interface = candidate.name
		probe.operstate = candidate.operstate
		probe.flags = candidate.flags
	end
	return probe
end

local identity_cache

local function identity_inventory()
	if not identity_cache then identity_cache = usb_identity.scan(USB_SYSFS_ROOT) end
	return identity_cache
end

local identity_labels = {
	android = "ANDROID USB IDENTITY",
	apple_mobile = "APPLE MOBILE USB IDENTITY",
	programmer = "FIRMWARE PROGRAMMER USB IDENTITY"
}

local identity_nouns = {
	android = "reviewed Android device",
	apple_mobile = "reviewed Apple mobile device",
	programmer = "reviewed firmware programmer"
}

local function apple_normal_udid(value)
	value = trim(value)
	if #value >= 8 and #value <= 64 and value:match("^[A-Za-z0-9-]+$") then return value end
	return nil
end

local function apple_recovery_ecid(value)
	value = trim(value)
	local ecid = value:match("[Ee][Cc][Ii][Dd]:?%s*(0[xX][0-9A-Fa-f]+)")
	if ecid then ecid = ecid:lower()
	else
		ecid = value:match("[Ee][Cc][Ii][Dd]:?%s*([0-9A-Fa-f]+)")
		if ecid then ecid = "0x" .. ecid:lower()
		elseif value:match("^0[xX][0-9A-Fa-f]+$") then ecid = value:lower()
		elseif value:match("^%d+$") then ecid = value
		elseif value:match("^[0-9A-Fa-f]+$") then ecid = "0x" .. value:lower() end
	end
	if not ecid then return nil end
	if #ecid < 5 or #ecid > 34 then return nil end
	return ecid
end

local function identity_probe(kind)
	local devices = identity_inventory()[kind] or {}
	local noun = identity_nouns[kind] or "reviewed device"
	local count = #devices
	local action_ready = count > 0
	local normal_count, recovery_count, dfu_count = 0, 0, 0
	if kind == "android" then
		action_ready = false
		for _, device in ipairs(devices) do
			for _, interface in ipairs(device.interfaces or {}) do
				if interface.signature == "ff:42:01" then action_ready = true; break end
			end
			if action_ready then break end
		end
	elseif kind == "apple_mobile" then
		for _, device in ipairs(devices) do
			if device.identity == "APPLE MOBILE DESCRIPTOR" and apple_normal_udid(device.serial) then normal_count = normal_count + 1
			elseif device.identity == "RECOVERY MODE DESCRIPTOR" and apple_recovery_ecid(device.serial) then recovery_count = recovery_count + 1
			elseif device.identity == "DFU MODE DESCRIPTOR" and apple_recovery_ecid(device.serial) then dfu_count = dfu_count + 1 end
		end
		action_ready = normal_count + recovery_count + dfu_count > 0
	end
	local reason
	if count == 0 then reason = "READY / NO DEVICE - NO " .. noun:upper() .. " DETECTED"
	elseif kind == "android" and not action_ready then reason = "REVIEWED ANDROID USB IDENTITY DETECTED WITHOUT AN ADB INTERFACE"
	elseif kind == "apple_mobile" and not action_ready then reason = "REVIEWED APPLE USB IDENTITY DETECTED WITHOUT A SELECTABLE UDID OR ECID"
	else reason = string.format("READY - %d %s%s DETECTED", count, noun:upper(), count == 1 and "" or "S") end
	return {
		hardware_present = count > 0,
		count = count,
		action_ready = action_ready,
		normal_count = normal_count,
		recovery_count = recovery_count,
		dfu_count = dfu_count,
		reason = reason
	}
end

local function identity_snapshot_text(kind)
	local inventory = identity_inventory()
	local devices = inventory[kind] or {}
	local label = identity_labels[kind] or "USB IDENTITY"
	local lines = {
		"DIGITAL DROPKICK — " .. label .. " SNAPSHOT",
		"Policy: sysfs metadata only; no device node, daemon, repair utility, recovery utility, debugger, or programmer was opened or started.",
		"Privacy: USB serial identifiers are shown only in this authenticated response and are not written to jobs, reports, logs, or persistent storage.",
		""
	}

	if #devices == 0 then
		lines[#lines + 1] = "No matching reviewed USB identity is currently detected."
	else
		local displayed = math.min(#devices, 8)
		for index = 1, displayed do
			local device = devices[index]
			lines[#lines + 1] = string.format("DEVICE %d", index)
			lines[#lines + 1] = "  Classification: " .. (device.identity or "REVIEWED USB IDENTITY")
			lines[#lines + 1] = "  USB: " .. device.usb_id
			lines[#lines + 1] = "  Manufacturer: " .. (device.manufacturer ~= "" and device.manufacturer or "UNAVAILABLE")
			lines[#lines + 1] = "  Product: " .. (device.product ~= "" and device.product or "UNAVAILABLE")
			lines[#lines + 1] = "  Serial identifier: " .. (device.serial ~= "" and device.serial or "UNAVAILABLE")
			lines[#lines + 1] = "  USB topology: " .. (device.topology ~= "" and device.topology or "UNAVAILABLE")
			lines[#lines + 1] = "  Link speed: " .. (device.speed ~= "" and device.speed .. " Mb/s" or "UNAVAILABLE")
			if #device.interfaces == 0 then
				lines[#lines + 1] = "  Interfaces: metadata unavailable"
			else
				for _, interface in ipairs(device.interfaces) do
					lines[#lines + 1] = string.format(
						"  Interface %s: %s; driver %s",
						interface.number ~= "" and interface.number or "?",
						interface.signature,
						interface.driver ~= "" and interface.driver or "unclaimed"
					)
				end
			end
			lines[#lines + 1] = ""
		end
		if #devices > displayed then
			lines[#lines + 1] = string.format("%d additional matching identities omitted by the eight-device display limit.", #devices - displayed)
		end
	end

	lines[#lines + 1] = string.format("Summary: %d matching device(s); %d USB device(s) inspected.", #devices, inventory.inspected_count or 0)
	lines[#lines + 1] = "Output lifetime: browser memory only; refresh or leave this page to discard it."
	return table.concat(lines, "\n") .. "\n"
end

