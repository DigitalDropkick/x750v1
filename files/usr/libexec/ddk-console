local upload_policies = {
	firmware_image = { maximum = 268435456, extensions = { bin = true, hex = true, elf = true, uf2 = true, dfu = true, fw = true, rom = true, img = true } },
	android_package = { maximum = 268435456, extensions = { apk = true, apks = true, zip = true } },
	android_backup = { maximum = 1073741824, extensions = { ab = true } },
	apple_restore = { maximum = 12884901888, extensions = { ipsw = true, zip = true } },
	apple_recovery_input = { maximum = 268435456, extensions = { bin = true, img = true, dfu = true, ibss = true, ibec = true, payload = true, txt = true, script = true, cfg = true } },
	apple_ticket = { maximum = 1048576, extensions = { shsh = true, ticket = true, bin = true, plist = true } },
	storage_image = { maximum = 17179869184, extensions = { raw = true, img = true, bin = true, dd = true, squashfs = true, sqfs = true } },
	device_input = { maximum = 268435456, extensions = { bin = true, hex = true, elf = true, uf2 = true, dfu = true, fw = true, rom = true, img = true, cfg = true, json = true, zip = true, tar = true, gz = true } },
	forensics_input = { maximum = 268435456, extensions = { bin = true, exe = true, dll = true, elf = true, so = true, apk = true, zip = true, img = true, raw = true, txt = true, rules = true, yar = true, yara = true, json = true, cfg = true, pcap = true, pcapng = true } },
	capture_input = { maximum = 1073741824, extensions = { pcap = true, pcapng = true, cap = true } }
}

local function valid_upload_id(value)
	return type(value) == "string" and value:match("^upload%-%d+%-%d+%-%d+$") ~= nil
end

local function valid_upload_name(value, policy)
	if type(value) ~= "string" or #value < 1 or #value > 128 or value:find("..", 1, true) or
	   value:find("[/\\%z\1-\31\127]") or not value:match("^[A-Za-z0-9][A-Za-z0-9_. ()+%-]*$") then return false end
	local extension = value:lower():match("[.]([a-z0-9]+)$")
	return extension ~= nil and policy.extensions[extension] == true
end

local function upload_metadata(path)
	return parse_json(fs.readfile(path .. "/metadata.json")) or parse_json(fs.readfile(path .. "/request.json"))
end

local function remove_upload_tree(path)
	local prefix = UPLOAD_ROOT .. "/"
	if path:sub(1, #prefix) ~= prefix or not valid_upload_id(path:sub(#prefix + 1)) then return false end
	for _, name in ipairs({ "payload.bin", "sealed.bin", "request.json", "metadata.json" }) do
		local child = path .. "/" .. name
		local stat = fs.lstat(child)
		if stat and stat.type == "reg" then fs.unlink(child)
		elseif name == "payload.bin" and stat and stat.type == "dir" then fs.rmdir(child) end
	end
	fs.rmdir(path)
	return true
end

local function cleanup_uploads()
	local now = os.time()
	local iterator = fs.dir(UPLOAD_ROOT)
	if not iterator then return end
	for name in iterator do
		if valid_upload_id(name) then
			local path = UPLOAD_ROOT .. "/" .. name
			local metadata = upload_metadata(path)
			local expires = type(metadata) == "table" and tonumber(metadata.expires_at) or nil
			local stat = fs.stat(path)
			local locked = fs.stat(LOCK_ROOT .. "/upload-" .. name) ~= nil
			if not locked and ((expires and expires < now) or (not expires and stat and now - (stat.mtime or now) > RESERVED_UPLOAD_MAX_AGE)) then remove_upload_tree(path) end
		end
	end
end

local function retained_upload_count()
	local count = 0
	local iterator = fs.dir(UPLOAD_ROOT)
	if iterator then for name in iterator do if valid_upload_id(name) then count = count + 1 end end end
	return count
end

local function reserve_upload(kind, encoded)
	local policy = upload_policies[kind]
	if not policy then return nil, "Unknown DDK upload kind" end
	local options, err = parse_operator_envelope(encoded)
	if not options then return nil, err end
	for key in pairs(options) do if key ~= "name" and key ~= "size" then return nil, "Unknown upload reservation field: " .. tostring(key) end end
	if not valid_upload_name(options.name, policy) then return nil, "Upload name or extension is not allowed for the selected DDK input kind" end
	if type(options.size) ~= "number" or options.size ~= math.floor(options.size) or options.size < 1 or options.size > policy.maximum then
		return nil, "Declared upload size is outside the selected DDK input limit"
	end
	local available_kb = tonumber(trim(capture("df -Pk /overlay | awk 'NR == 2 {print $4}'", 128, 5))) or 0
	if available_kb < math.ceil((options.size + MIN_OVERLAY_RESERVE) / 1024) then
		return nil, "Extroot does not have enough free space for this upload and the protected appliance reserve"
	end
	fs.mkdirr(UPLOAD_ROOT)
	fs.chmod(UPLOAD_PARENT, "0700")
	fs.chmod(UPLOAD_ROOT, "0700")
	local root_stat = fs.stat(UPLOAD_ROOT)
	if not root_stat or root_stat.type ~= "dir" then return nil, "Unable to initialize DDK-controlled upload storage" end
	cleanup_uploads()
	if retained_upload_count() >= MAX_RETAINED_UPLOADS then return nil, "Ten DDK input files are already retained; delete or wait for expiry before reserving another" end
	local created = os.time()
	local upload_id, path
	for counter = 1, 100 do
		upload_id = string.format("upload-%d-%d-%d", created, nixio.getpid(), counter)
		path = UPLOAD_ROOT .. "/" .. upload_id
		if not fs.stat(path) and fs.mkdir(path, "0700") then break end
		upload_id, path = nil, nil
	end
	if not upload_id then return nil, "Unable to allocate a DDK upload reservation" end
	local metadata = {
		id = upload_id, phase = "reserved", kind = kind, original_name = options.name,
		declared_size = options.size, maximum_size = policy.maximum, created_at = created,
		expires_at = created + RESERVED_UPLOAD_MAX_AGE
	}
	local metadata_body = json.stringify(metadata)
	if not metadata_body or not write_file(path .. "/request.json", metadata_body .. "\n") then
		remove_upload_tree(path)
		return nil, "Unable to persist the DDK upload reservation"
	end
	fs.chmod(path .. "/request.json", "0600")
	return { id = upload_id, kind = kind, original_name = options.name, declared_size = options.size, maximum_size = policy.maximum, upload_path = path .. "/payload.bin", expires_at = metadata.expires_at }
end

local function finalize_upload(upload_id)
	if not valid_upload_id(upload_id) then return nil, "Invalid DDK upload ID" end
	cleanup_uploads()
	local path = UPLOAD_ROOT .. "/" .. upload_id
	local metadata = parse_json(fs.readfile(path .. "/request.json"))
	local expires_at = type(metadata) == "table" and tonumber(metadata.expires_at) or nil
	if type(metadata) ~= "table" or metadata.id ~= upload_id or metadata.phase ~= "reserved" or
	   not expires_at or expires_at < os.time() then
		return nil, "Upload reservation was not found or expired"
	end
	local policy = upload_policies[metadata.kind]
	if not policy or not valid_upload_name(metadata.original_name, policy) then return nil, "Upload reservation metadata is invalid" end
	local payload = path .. "/payload.bin"
	local stat = fs.lstat(payload)
	if not stat or stat.type ~= "reg" or stat.size ~= metadata.declared_size or stat.size < 1 or stat.size > policy.maximum then
		return nil, "Uploaded file is absent, unsafe, or does not match the declared bounded size"
	end
	local sealed = path .. "/sealed.bin"
	if fs.lstat(sealed) or not fs.rename(payload, sealed) then return nil, "Unable to atomically seal the uploaded file" end
	fs.chmod(sealed, "0600")
	if not fs.mkdir(payload, "0000") then remove_upload_tree(path); return nil, "Unable to close the authenticated upload path after sealing" end
	local sealed_stat = fs.lstat(sealed)
	if not sealed_stat or sealed_stat.type ~= "reg" or sealed_stat.size ~= metadata.declared_size then remove_upload_tree(path); return nil, "Sealed upload failed its post-rename validation" end
	local head = read_limited(sealed, 15) or ""
	if (metadata.kind == "android_package" or metadata.kind == "apple_restore") and head:sub(1, 4) ~= string.char(80, 75, 3, 4) then
		remove_upload_tree(path)
		return nil, "Uploaded package/archive does not have the required ZIP signature"
	end
	if metadata.kind == "android_backup" and head ~= "ANDROID BACKUP\n" then
		remove_upload_tree(path)
		return nil, "Uploaded Android backup does not have the required ADB backup header"
	end
	local digest_output = capture("/usr/bin/sha256sum " .. sealed, 256, 1800)
	local digest = digest_output:match("^(%x+)%s")
	if not digest or #digest ~= 64 then remove_upload_tree(path); return nil, "Unable to compute the sealed upload SHA-256" end
	metadata.phase = "sealed"
	metadata.size = sealed_stat.size
	metadata.sha256 = digest:lower()
	metadata.sealed_at = os.time()
	metadata.expires_at = metadata.sealed_at + SEALED_UPLOAD_MAX_AGE
	local metadata_body = json.stringify(metadata)
	if not metadata_body or not write_file(path .. "/metadata.json", metadata_body .. "\n") then
		remove_upload_tree(path)
		return nil, "Unable to persist sealed upload metadata"
	end
	fs.chmod(path .. "/metadata.json", "0600")
	fs.unlink(path .. "/request.json")
	return { id = metadata.id, kind = metadata.kind, original_name = metadata.original_name, size = metadata.size, sha256 = metadata.sha256, sealed_at = metadata.sealed_at, expires_at = metadata.expires_at }
end

local function sealed_upload_record(upload_id, expected_kind)
	if not valid_upload_id(upload_id) then return nil, "Invalid DDK upload ID" end
	local path = UPLOAD_ROOT .. "/" .. upload_id
	local metadata = parse_json(fs.readfile(path .. "/metadata.json"))
	local expires_at = type(metadata) == "table" and tonumber(metadata.expires_at) or nil
	local size = type(metadata) == "table" and tonumber(metadata.size) or nil
	local policy = type(metadata) == "table" and upload_policies[metadata.kind] or nil
	if type(metadata) ~= "table" or metadata.id ~= upload_id or metadata.phase ~= "sealed" or
	   not expires_at or expires_at < os.time() or not policy or
	   (expected_kind and metadata.kind ~= expected_kind) or not valid_upload_name(metadata.original_name, policy) or
	   not size or size ~= math.floor(size) or size < 1 or size > policy.maximum or
	   type(metadata.sha256) ~= "string" or not metadata.sha256:match("^[0-9a-f]+$") or #metadata.sha256 ~= 64 then
		return nil, "Sealed DDK upload metadata is invalid, expired, or the wrong kind"
	end
	local sealed_path = path .. "/sealed.bin"
	local sealed_stat = fs.lstat(sealed_path)
	local closed_path_stat = fs.lstat(path .. "/payload.bin")
	if not sealed_stat or sealed_stat.type ~= "reg" or sealed_stat.size ~= size or
	   not closed_path_stat or closed_path_stat.type ~= "dir" then
		return nil, "Sealed DDK upload storage does not match its validated metadata"
	end
	return {
		id = upload_id, kind = metadata.kind, original_name = metadata.original_name,
		size = size, sha256 = metadata.sha256, sealed_at = metadata.sealed_at,
		expires_at = expires_at, sealed_path = sealed_path
	}
end

local function list_uploads()
	cleanup_uploads()
	local uploads = {}
	local iterator = fs.dir(UPLOAD_ROOT)
	if iterator then
		for name in iterator do
			if valid_upload_id(name) then
				local metadata = sealed_upload_record(name)
				if metadata then
					metadata.sealed_path = nil
					uploads[#uploads + 1] = metadata
				end
			end
		end
	end
	table.sort(uploads, function(a, b) return (a.sealed_at or 0) > (b.sealed_at or 0) end)
	return uploads
end

local function delete_upload_unlocked(upload_id)
	if not valid_upload_id(upload_id) then return nil, "Invalid DDK upload ID" end
	local path = UPLOAD_ROOT .. "/" .. upload_id
	if not fs.stat(path) then return nil, "DDK upload was not found" end
	if not remove_upload_tree(path) then return nil, "Unable to remove the DDK upload" end
	return { id = upload_id, deleted = true }
end

local delete_upload
local acquire_lock
local release_lock

local function valid_job_id(value)
	return type(value) == "string" and value:match("^job%-%d+%-%d+$") ~= nil
end

local function valid_report_id(value)
	return type(value) == "string" and value:match("^report%-%d+%-%d+$") ~= nil
end

local function valid_prepared_id(value)
	return type(value) == "string" and value:match("^prep%-%d+%-%d+%-%d+$") ~= nil
end

local function adb_devices_probe()
	if not binary_exists("/usr/bin/adb") then return {}, "ADB 1.0.32 IS UNAVAILABLE" end
	local identities = {}
	for _, device in ipairs(identity_inventory().android or {}) do
		local adb_interface = false
		for _, interface in ipairs(device.interfaces or {}) do
			if interface.signature == "ff:42:01" then adb_interface = true; break end
		end
		if adb_interface then identities[#identities + 1] = device end
	end
	if #identities == 0 then return {}, "NO REVIEWED USB ADB IDENTITY" end
	fs.mkdirr(LOCK_ROOT)
	fs.chmod("/tmp/ddk", "0700")
	fs.chmod(LOCK_ROOT, "0700")
	local probe_owner = "probe-" .. tostring(os.time()) .. "-" .. tostring(nixio.getpid())
	local locked = acquire_lock("resource-adb", probe_owner)
	if not locked then return {}, "ADB RESOURCE IS BUSY" end
	local function finish(devices, reason)
		release_lock("resource-adb", probe_owner)
		return devices, reason
	end
	if trim(capture("netstat -lnt 2>/dev/null | grep -E '(^|[.:])5038[[:space:]]'")) ~= "" then
		return finish({}, "ISOLATED DDK ADB SERVER PORT 5038 IS ALREADY IN USE")
	end
	local output = capture("/usr/bin/adb -P 5038 devices -l", MAX_CAPTURE, 15)
	capture("/usr/bin/adb -P 5038 kill-server", 4096, 10)
	if trim(capture("netstat -lnt 2>/dev/null | grep -E '(^|[.:])5038[[:space:]]'")) ~= "" then
		return finish({}, "TEMPORARY DDK ADB SERVER DID NOT CLEAN UP")
	end
	local rows = {}
	for line in output:gmatch("[^\r\n]+") do
		local serial, state, detail = line:match("^([^%s]+)%s+([^%s]+)%s*(.*)$")
		if serial and state and serial ~= "List" and serial ~= "*" and #serial <= 128 and
		   serial:match("^[A-Za-z0-9._-]+$") and state:match("^[a-z]+$") then
			rows[#rows + 1] = { serial = serial, state = state, detail = detail or "" }
		end
	end
	local devices = {}
	for _, row in ipairs(rows) do
		local matched
		for _, identity in ipairs(identities) do
			if identity.serial ~= "" and identity.serial == row.serial then matched = identity; break end
		end
		if not matched and #rows == 1 and #identities == 1 then matched = identities[1] end
		if matched then
			local model = row.detail:match("model:([^%s]+)") or matched.product or "Android"
			devices[#devices + 1] = {
				serial = row.serial, state = row.state,
				label = row.serial .. " / " .. row.state .. " / " .. trim(model):sub(1, 64),
				usb_id = matched.usb_id, topology = matched.topology
			}
		end
	end
	table.sort(devices, function(a, b) return a.label < b.label end)
	return finish(devices, #devices > 0 and "READY" or "NO AUTHORIZED REVIEWED USB ADB TRANSPORT")
end

local function phase4_wireless_interfaces()
	local result, seen = {}, {}
	for line in capture("/usr/sbin/iw dev", 32768, 10):gmatch("[^\r\n]+") do
		local name = line:match("^%s+Interface%s+([A-Za-z0-9_.-]+)%s*$")
		if name and #name <= 15 and not seen[name] and fs.stat("/sys/class/net/" .. name) then
			seen[name] = true
			result[#result + 1] = { value = name, name = name, label = name }
		end
	end
	table.sort(result, function(a, b) return a.value < b.value end)
	return result
end

local function phase4_bluetooth_devices()
	local result = {}
	local iterator = fs.dir("/sys/class/bluetooth")
	if iterator then
		for name in iterator do
			if name:match("^hci%d+$") then
				local output = capture("/usr/bin/hciconfig " .. name, 8192, 10)
				if output:match("%sUP%s") and output:match("%sRUNNING%s") then
					result[#result + 1] = { value = name, name = name, label = name .. " / UP RUNNING" }
				end
			end
		end
	end
	table.sort(result, function(a, b) return a.value < b.value end)
	return result
end

local function phase4_usb_devices()
	local result, seen = {}, {}
	local lines = usb_lines()
	for _, line in ipairs(lines) do
		local bus, device, usb_id, description = line:match("^Bus%s+(%d+)%s+Device%s+(%d+):%s+ID%s+([0-9A-Fa-f]+:[0-9A-Fa-f]+)%s*(.*)$")
		if bus and device and usb_id then
			usb_id = usb_id:lower()
			local value = bus .. ":" .. device .. ":" .. usb_id
			if not seen[value] then
				seen[value] = true
				result[#result + 1] = { value = value, usb_id = usb_id, bus = bus, device = device, label = "Bus " .. bus .. " Device " .. device .. " / " .. usb_id .. (description ~= "" and (" / " .. safe_label(description, 96)) or "") }
			end
		end
	end
	return result
end

phase4_relay_devices = function()
	local result, seen = {}, {}
	for line in capture("/usr/bin/crelay -i", 32768, 10):gmatch("[^\r\n]+") do
		local serial = line:match("%([Ss]erial%s+([A-Za-z0-9_.-]+)%)") or line:match("[Ss]erial[:%s]+([A-Za-z0-9_.-]+)")
		if serial and #serial <= 128 and not seen[serial] then
			seen[serial] = true
			result[#result + 1] = { value = serial, serial = serial, relays = 16, label = safe_label(line, 128) }
		end
	end
	table.sort(result, function(a, b) return a.value < b.value end)
	return result
end

local function operator_context(action_id)
	local lan = ubus_object("ubus call network.interface.lan status")
	local lan_address = ""
	local local_addresses = {}
	local addresses = lan["ipv4-address"]
	if type(addresses) == "table" and type(addresses[1]) == "table" and
	   type(addresses[1].address) == "string" and type(addresses[1].mask) == "number" then
		lan_address = addresses[1].address .. "/" .. tostring(addresses[1].mask)
	end
	local address_output = capture("ip -o addr show")
	for line in address_output:gmatch("[^\n]+") do
		local interface, family, address = line:match("^%d+:%s+([^%s]+)%s+(inet6?)%s+([^%s/]+)")
		if interface and address then
			interface = interface:gsub("@.*$", "")
			if interface:match("^[A-Za-z0-9_.-]+$") and address:match("^[A-Za-z0-9:.]+$") then
				local_addresses[#local_addresses + 1] = { address = address, interface = interface, family = family }
			end
		end
	end
	local congestion = {}
	for name in (fs.readfile("/proc/sys/net/ipv4/tcp_available_congestion_control") or ""):gmatch("%S+") do
		if name:match("^[A-Za-z0-9_.-]+$") then congestion[#congestion + 1] = name end
	end
	local rtl = rtl_sdr_probe()
	local camera = camera_probe()
	local wireless_interfaces = phase4_wireless_interfaces()
	local bluetooth_devices = action_id == "bluetooth.scan" and phase4_bluetooth_devices() or {}
	local usb_devices = action_id == "usb.inventory" and phase4_usb_devices() or {}
	local relay_devices = action_id == "automation.relay" and phase4_relay_devices() or {}
	local camera_devices = {}
	for _, item in ipairs(camera.nodes or {}) do
		if item.index == "0" then
			camera_devices[#camera_devices + 1] = {
				value = item.node,
				node = item.node,
				usb_id = item.usb_id,
				label = item.node .. " / " .. item.usb_id .. (item.name ~= "" and (" / " .. item.name) or "")
			}
		end
	end
	local serial_inventory = serial_attribution()
	local serial_devices = {}
	for _, item in ipairs(serial_inventory or {}) do
		if item.generic_use_allowed and not device_open_by_process(item.node) then
			serial_devices[#serial_devices + 1] = {
				value = item.node,
				node = item.node,
				topology = item.usb.parent,
				usb_id = item.usb.vendor_id .. ":" .. item.usb.product_id,
				label = item.node .. " / " .. item.usb.vendor_id .. ":" .. item.usb.product_id .. " / " .. item.owner
			}
		end
	end
	local gps = gps_probe()
	local gps_devices = {}
	for _, item in ipairs(gps.available_nodes or {}) do
		gps_devices[#gps_devices + 1] = {
			value = item.node,
			node = item.node,
			usb_id = item.usb_id,
			label = item.node .. " / " .. item.usb_id .. " / " .. trim(item.manufacturer .. " " .. item.product)
		}
	end
	local android_devices, android_reason = {}, "ADB DISCOVERY NOT REQUESTED"
	if action_id == "android.adb_diagnostics" or action_id == "android.adb_manage" then
		android_devices, android_reason = adb_devices_probe()
	end
	local apple_normal_devices, apple_recovery_devices, apple_restore_devices = {}, {}, {}
	if type(action_id) == "string" and action_id:match("^apple[.]") then
		local seen_normal, seen_recovery = {}, {}
		for _, device in ipairs(identity_inventory().apple_mobile or {}) do
			local serial = trim(device.serial)
			local normal_udid = apple_normal_udid(serial)
			if device.identity == "APPLE MOBILE DESCRIPTOR" and normal_udid and not seen_normal[normal_udid] then
				serial = normal_udid
				seen_normal[serial] = true
				local label = serial .. " / NORMAL / " .. (device.product ~= "" and device.product or device.usb_id)
				apple_normal_devices[#apple_normal_devices + 1] = { value = serial, label = label, udid = serial, mode = "normal", usb_id = device.usb_id, topology = device.topology }
				apple_restore_devices[#apple_restore_devices + 1] = { value = "udid:" .. serial, label = label, selector = "udid", identifier = serial, mode = "normal" }
			elseif device.identity == "RECOVERY MODE DESCRIPTOR" or device.identity == "DFU MODE DESCRIPTOR" then
				local ecid = apple_recovery_ecid(serial)
				if ecid then
					if not seen_recovery[ecid] then
						seen_recovery[ecid] = true
						local mode = device.identity == "DFU MODE DESCRIPTOR" and "dfu" or "recovery"
						local label = ecid .. " / " .. mode:upper() .. " / " .. (device.product ~= "" and device.product or device.usb_id)
						apple_recovery_devices[#apple_recovery_devices + 1] = { value = "ecid:" .. ecid, label = label, ecid = ecid, mode = mode, usb_id = device.usb_id, topology = device.topology }
						apple_restore_devices[#apple_restore_devices + 1] = { value = "ecid:" .. ecid, label = label, selector = "ecid", identifier = ecid, mode = mode }
					end
				end
			end
		end
		table.sort(apple_normal_devices, function(a, b) return a.value < b.value end)
		table.sort(apple_recovery_devices, function(a, b) return a.value < b.value end)
		table.sort(apple_restore_devices, function(a, b) return a.value < b.value end)
	end
	local phase3 = phase3_context(action_id)
	return {
		interfaces = interface_list(),
		wireless_interfaces = wireless_interfaces,
		bluetooth_devices = bluetooth_devices,
		usb_devices = usb_devices,
		relay_devices = relay_devices,
		lan_interface = lan.l3_device or lan.device or "",
		lan_cidr = lan_address,
		local_addresses = local_addresses,
		congestion_controls = congestion,
		rtl_devices = rtl.devices or {},
		camera_devices = camera_devices,
		serial_devices = serial_devices,
		gps_devices = gps_devices,
		android_devices = android_devices,
		android_reason = android_reason,
		apple_normal_devices = apple_normal_devices,
		apple_recovery_devices = apple_recovery_devices,
		apple_restore_devices = apple_restore_devices,
		programmer_devices = phase3.programmer_devices,
		dfu_devices = phase3.dfu_devices,
		firmware_serial_devices = phase3.firmware_serial_devices,
		firmware_connection_devices = phase3.firmware_connection_devices,
		openocd_interface_configs = phase3.openocd_interface_configs,
		openocd_target_configs = phase3.openocd_target_configs,
		openocd_board_configs = phase3.openocd_board_configs,
		avrdude_programmers = phase3.avrdude_programmers,
		avrdude_parts = phase3.avrdude_parts,
		dfu_programmer_targets = phase3.dfu_programmer_targets,
		storage_devices = phase3.storage_devices,
		uploads = list_uploads()
	}
end

local function remove_prepared_tree(path)
	if not path:match("^/tmp/ddk/prepared/prep%-%d+%-%d+%-%d+[.]claim%-%d+$") and
	   not path:match("^/tmp/ddk/prepared/prep%-%d+%-%d+%-%d+$") then return false end
	local iterator = fs.dir(path)
	if iterator then
		for name in iterator do
			if name ~= "." and name ~= ".." and name:match("^[A-Za-z0-9_.-]+$") then
				local child = path .. "/" .. name
				local stat = fs.lstat(child)
				if stat and stat.type == "reg" then fs.unlink(child) end
			end
		end
	end
	fs.rmdir(path)
	return true
end

local function cleanup_prepared()
	local now = os.time()
	local iterator = fs.dir(PREPARED_ROOT)
	if not iterator then return end
	for name in iterator do
		if valid_prepared_id(name) or name:match("^prep%-%d+%-%d+%-%d+[.]claim%-%d+$") then
			local path = PREPARED_ROOT .. "/" .. name
			local stat = fs.stat(path)
			if stat and now - (stat.mtime or now) > PREPARED_MAX_AGE then remove_prepared_tree(path) end
		end
	end
end

local function operator_module_for(action_id)
	if type(action_id) == "string" and action_id:match("^apple[.]") then return operator_apple end
	if type(action_id) == "string" and (action_id:match("^firmware[.]") or action_id:match("^storage[.]")) then return operator_phase3 end
	if ({
		["monitoring.snapshot"] = true, ["wireless.survey"] = true, ["usb.inventory"] = true,
		["forensics.inspect_file"] = true, ["capture.replay"] = true, ["adsb.receive"] = true,
		["radio.ais"] = true, ["bluetooth.scan"] = true, ["automation.mqtt_publish"] = true,
		["automation.relay"] = true, ["industrial.modbus_read"] = true, ["auth.inventory"] = true,
		["auth.program"] = true, ["camera.stream"] = true, ["gps.ntrip"] = true
	})[action_id] then return operator_phase4 end
	return operator_actions
end

local function describe_operator_action(action_id)
	local module = operator_module_for(action_id)
	local schema, err = module.describe(action_id, operator_context(action_id))
	if not schema then return nil, err end
	local executables = type(schema.native) == "table" and schema.native.executables or nil
	if type(executables) ~= "table" then executables = { schema.native and schema.native.executable or "" } end
	for _, executable in ipairs(executables) do
		if not binary_exists(executable) then return nil, "An exact native executable required by this action is unavailable: " .. tostring(executable) end
	end
	return schema
end

