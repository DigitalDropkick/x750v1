local function operator_guide_text(kind)
	local guide = operator_guides[kind]
	if not guide then return "Unknown operator guide.\n" end
	local lines = {
		"DIGITAL DROPKICK — " .. guide.title,
		"Policy: these are supplemental copyable references only. The browser does not execute any displayed command.",
		"Structured GUI Operator Mode is the primary interface for represented native workflows; SSH remains available for installed capability not yet modeled by an exact schema.",
		"",
		"[EXECUTABLE READINESS]"
	}
	for _, binary in ipairs(guide.binaries) do
		lines[#lines + 1] = string.format("  %-18s %s", binary, binary_exists(binary) and "INSTALLED" or "UNAVAILABLE")
	end
	lines[#lines + 1] = ""
	lines[#lines + 1] = "[SUPPLEMENTAL NATIVE CLI REFERENCE]"
	for _, line in ipairs(guide.lines) do lines[#lines + 1] = "  " .. line end
	lines[#lines + 1] = ""
	lines[#lines + 1] = "[OPERATOR WARNING]"
	lines[#lines + 1] = "  " .. guide.warning
	lines[#lines + 1] = ""
	lines[#lines + 1] = "No native command above was run by this reference request."
	return table.concat(lines, "\n") .. "\n"
end

local function serial_attribution()
	local nodes = list_device_nodes("^ttyUSB%d+$")
	for _, node in ipairs(list_device_nodes("^ttyACM%d+$")) do
		nodes[#nodes + 1] = node
	end
	table.sort(nodes)

	local devices = {}
	local summary = {
		total = 0,
		modem_reserved = 0,
		reviewed_general_purpose = 0,
		unreviewed = 0,
		unattributed = 0
	}

	for _, node in ipairs(nodes) do
		local name = node:match("^/dev/(.+)$") or ""
		local base = "/sys/class/tty/" .. name
		local interface_path = fs.realpath(base .. "/device/..") or ""
		local parent_path = fs.realpath(base .. "/device/../..") or ""
		local interface_number = trim(fs.readfile(base .. "/device/../bInterfaceNumber"))
		local vendor_id = trim(fs.readfile(base .. "/device/../../idVendor")):lower()
		local product_id = trim(fs.readfile(base .. "/device/../../idProduct")):lower()
		local manufacturer = trim(fs.readfile(base .. "/device/../../manufacturer"))
		local product = trim(fs.readfile(base .. "/device/../../product"))
		local driver_link = fs.readlink(base .. "/device/../driver") or ""
		local driver = driver_link:match("([^/]+)$") or ""
		local parent = parent_path:match("([^/]+)$") or ""
		local exact_ec25 = vendor_id == "2c7c" and product_id == "0125" and
			manufacturer:lower() == "quectel" and product:lower():match("^ec25") ~= nil and driver == "option"
		local reviewed_driver = driver == "cdc_acm" or driver == "ftdi_sio" or driver == "cp210x" or
			driver == "pl2303" or driver == "ch341" or driver == "usbserial"
		local valid_usb_identity = vendor_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil and
			product_id:match("^[0-9a-f][0-9a-f][0-9a-f][0-9a-f]$") ~= nil
		local classification
		local owner

		if exact_ec25 then
			classification = "MODEM RESERVED"
			owner = "Quectel EC25-AF cellular modem"
			summary.modem_reserved = summary.modem_reserved + 1
		elseif reviewed_driver and valid_usb_identity then
			classification = "REVIEWED GENERAL PURPOSE"
			owner = trim(manufacturer .. " " .. product)
			if owner == "" then owner = "USB serial adapter " .. vendor_id .. ":" .. product_id end
			summary.reviewed_general_purpose = summary.reviewed_general_purpose + 1
		elseif vendor_id ~= "" and product_id ~= "" then
			classification = "UNREVIEWED SERIAL"
			owner = trim(manufacturer .. " " .. product)
			if owner == "" then owner = "Unknown USB serial device" end
			summary.unreviewed = summary.unreviewed + 1
		else
			classification = "UNATTRIBUTED"
			owner = "Sysfs USB parent unavailable"
			summary.unattributed = summary.unattributed + 1
		end

		devices[#devices + 1] = {
			node = node,
			classification = classification,
			owner = owner,
			generic_use_allowed = classification == "REVIEWED GENERAL PURPOSE",
			usb = {
				vendor_id = vendor_id,
				product_id = product_id,
				manufacturer = manufacturer,
				product = product,
				parent = parent,
				interface_number = interface_number,
				driver = driver,
				interface_path = interface_path
			}
		}
	end

	summary.total = #devices
	return devices, summary
end

local function serial_attribution_text()
	local devices, summary = serial_attribution()
	local lines = {
		"SERIAL DEVICE ATTRIBUTION (SYSFS ONLY)",
		"Policy: read metadata only; no serial port was opened.",
		""
	}

	if #devices == 0 then
		lines[#lines + 1] = "No /dev/ttyUSB* or /dev/ttyACM* nodes detected."
	else
		for _, device in ipairs(devices) do
			local usb_id = device.usb.vendor_id ~= "" and device.usb.product_id ~= "" and
				(device.usb.vendor_id .. ":" .. device.usb.product_id) or "unavailable"
			lines[#lines + 1] = device.node
			lines[#lines + 1] = "  Classification: " .. device.classification
			lines[#lines + 1] = "  Owner: " .. device.owner
			lines[#lines + 1] = "  USB: " .. usb_id
			lines[#lines + 1] = "  Parent: " .. (device.usb.parent ~= "" and device.usb.parent or "unavailable")
			lines[#lines + 1] = "  Interface: " .. (device.usb.interface_number ~= "" and device.usb.interface_number or "unavailable")
			lines[#lines + 1] = "  Driver: " .. (device.usb.driver ~= "" and device.usb.driver or "unavailable")
			lines[#lines + 1] = "  Generic use allowed: " .. (device.generic_use_allowed and "YES" or "NO")
			lines[#lines + 1] = ""
		end
	end

	lines[#lines + 1] = string.format(
		"Summary: %d total; %d modem-reserved; %d reviewed general-purpose; %d unreviewed; %d unattributed.",
		summary.total,
		summary.modem_reserved,
		summary.reviewed_general_purpose,
		summary.unreviewed,
		summary.unattributed
	)
	return table.concat(lines, "\n") .. "\n"
end

local function safe_label(value, limit)
	value = trim(value):gsub("[%z\1-\31\127]", " "):gsub("[^A-Za-z0-9 _%.%-%+%:/%(%),#%[%]]", "?"):gsub("%s+", " ")
	return value:sub(1, limit or 96)
end

local function storage_source_disk(source)
	local name = tostring(source or ""):match("^/dev/(sd[a-z]+)%d*$")
	return name
end

local function protected_storage_disks()
	local protected = {}
	for line in (fs.readfile("/proc/mounts") or ""):gmatch("[^\n]+") do
		local source, mountpoint = line:match("^(%S+)%s+(%S+)")
		if mountpoint == "/" or mountpoint == "/overlay" or mountpoint == "/rom" or mountpoint == "/mnt/extroot" then
			local disk = storage_source_disk(source)
			if disk then protected[disk] = true end
		end
	end
	for line in (fs.readfile("/proc/swaps") or ""):gmatch("[^\n]+") do
		local source = line:match("^(%S+)")
		local disk = storage_source_disk(source)
		if disk then protected[disk] = true end
	end
	return protected
end

local function mounted_block_sources()
	local mounted = {}
	for line in (fs.readfile("/proc/mounts") or ""):gmatch("[^\n]+") do
		local source, mountpoint = line:match("^(%S+)%s+(%S+)")
		if source and source:match("^/dev/sd[a-z]+%d*$") then mounted[source] = mountpoint or "mounted" end
	end
	return mounted
end

local function storage_inventory()
	local devices, protected, mounted = {}, protected_storage_disks(), mounted_block_sources()
	local iterator = fs.dir("/sys/class/block")
	if not iterator then return devices end
	for name in iterator do
		if #devices >= 64 then break end
		local disk = name:match("^(sd[a-z]+)%d+$") or name:match("^(sd[a-z]+)$")
		local disk_path = disk and fs.realpath("/sys/class/block/" .. disk) or ""
		if disk and not protected[disk] and disk_path:find("/usb", 1, true) then
			local node = "/dev/" .. name
			local stat = fs.stat(node)
			local sectors = tonumber(trim(fs.readfile("/sys/class/block/" .. name .. "/size"))) or 0
			local size = sectors * 512
			if stat and stat.type == "blk" and size > 0 then
				local kind = trim(fs.readfile("/sys/class/block/" .. name .. "/partition")) ~= "" and "partition" or "disk"
				local fs_type = trim(capture("/usr/sbin/blkid -o value -s TYPE " .. node, 128, 3)):lower()
				if not fs_type:match("^[a-z0-9+_.-]*$") then fs_type = "" end
				local model = safe_label(fs.readfile("/sys/class/block/" .. disk .. "/device/model"), 64)
				local vendor = safe_label(fs.readfile("/sys/class/block/" .. disk .. "/device/vendor"), 32)
				local mountpoint = mounted[node] or ""
				devices[#devices + 1] = {
					value = node, node = node, disk = disk, kind = kind, size = size, fs_type = fs_type,
					mounted = mountpoint ~= "", mountpoint = mountpoint,
					label = node .. " / " .. kind .. " / " .. tostring(size) .. " bytes" .. (fs_type ~= "" and (" / " .. fs_type) or "") ..
						(trim(vendor .. " " .. model) ~= "" and (" / " .. trim(vendor .. " " .. model)) or "") .. (mountpoint ~= "" and (" / MOUNTED " .. mountpoint) or " / UNMOUNTED")
				}
			end
		end
	end
	table.sort(devices, function(a, b) return a.value < b.value end)
	return devices
end

local function firmware_inventories()
	local programmers, debug_adapters, dfu, serials, connections = {}, {}, {}, {}, {}
	for _, device in ipairs(identity_inventory().programmer or {}) do
		if device.topology:match("^[A-Za-z0-9_.:%-]+$") and device.usb_id:match("^[0-9a-f]+:[0-9a-f]+$") then
			local value = "usb:" .. device.topology
			local stable_serial = type(device.serial) == "string" and #device.serial <= 128 and device.serial:match("^[A-Za-z0-9._-]+$") and device.serial or ""
			local record = { value = value, label = value .. " / " .. device.usb_id .. " / " .. (device.identity or "reviewed programmer"), kind = "usb", topology = device.topology, usb_id = device.usb_id, serial = stable_serial, busnum = tonumber(device.busnum), devnum = tonumber(device.devnum), identity = device.identity or "" }
			programmers[#programmers + 1] = record
			connections[#connections + 1] = record
			local is_dfu = false
			for _, interface in ipairs(device.interfaces or {}) do if interface.signature == "fe:01:01" or interface.signature == "fe:01:02" then is_dfu = true; break end end
			if is_dfu and record.busnum and record.devnum then dfu[#dfu + 1] = record else debug_adapters[#debug_adapters + 1] = record end
		end
	end
	for _, device in ipairs((serial_attribution())) do
		if device.generic_use_allowed and not device_open_by_process(device.node) then
			local usb_id = device.usb.vendor_id .. ":" .. device.usb.product_id
			local record = { value = device.node, node = device.node, label = device.node .. " / " .. usb_id .. " / " .. device.owner, kind = "serial", topology = device.usb.parent, usb_id = usb_id }
			serials[#serials + 1] = record
			connections[#connections + 1] = record
		end
	end
	local function sorter(a, b) return a.value < b.value end
	table.sort(programmers, sorter); table.sort(debug_adapters, sorter); table.sort(dfu, sorter); table.sort(serials, sorter); table.sort(connections, sorter)
	return { programmer_devices = programmers, debug_adapter_devices = debug_adapters, dfu_devices = dfu, serial_devices = serials, connection_devices = connections,
		action_ready = #programmers + #serials > 0,
		reason = (#programmers + #serials > 0) and string.format("READY - %d USB PROGRAMMER(S), %d SERIAL BOOTLOADER PORT(S)", #programmers, #serials) or "READY / NO DEVICE - NO REVIEWED PROGRAMMER OR NON-EC25 SERIAL TARGET" }
end

local function config_choices(group, maximum)
	local choices = {}
	if not ({ interface=true, target=true, board=true })[group] then return choices end
	local output = capture("find /usr/share/openocd/scripts/" .. group .. " -type f -name '*.cfg' | sort", 131072, 10)
	for line in output:gmatch("[^\r\n]+") do
		if #choices >= (maximum or 512) then break end
		local relative = line:match("^/usr/share/openocd/scripts/(" .. group .. "/[A-Za-z0-9_./+%-]+[.]cfg)$")
		if relative and not relative:find("..", 1, true) then choices[#choices + 1] = { value = relative, label = relative } end
	end
	return choices
end

local function parse_native_choices(command, pattern, maximum)
	local choices, seen = {}, {}
	for line in capture(command, 131072, 15):gmatch("[^\r\n]+") do
		local value, label = line:match(pattern)
		if value and not seen[value] and #choices < (maximum or 512) then
			seen[value] = true
			choices[#choices + 1] = { value = value, label = value .. (label and label ~= "" and (" / " .. safe_label(label, 96)) or "") }
		end
	end
	table.sort(choices, function(a, b) return a.value < b.value end)
	return choices
end

local function phase3_context(action_id)
	local result = {
		programmer_devices = {}, dfu_devices = {}, firmware_serial_devices = {}, firmware_connection_devices = {},
		openocd_interface_configs = {}, openocd_target_configs = {}, openocd_board_configs = {},
		avrdude_programmers = {}, avrdude_parts = {}, dfu_programmer_targets = {}, storage_devices = {}
	}
	if type(action_id) == "string" and action_id:match("^firmware[.]") then
		local firmware = firmware_inventories()
		result.programmer_devices = action_id == "firmware.openocd" and firmware.debug_adapter_devices or firmware.programmer_devices
		result.dfu_devices = firmware.dfu_devices
		result.firmware_serial_devices = firmware.serial_devices
		result.firmware_connection_devices = firmware.connection_devices
		if action_id == "firmware.openocd" then
			result.openocd_interface_configs = config_choices("interface", 256)
			result.openocd_target_configs = config_choices("target", 512)
			result.openocd_board_configs = config_choices("board", 512)
		elseif action_id == "firmware.avrdude" then
			result.avrdude_programmers = parse_native_choices("/usr/bin/avrdude -c '?'", "^%s+([A-Za-z0-9_-]+)%s+=%s*(.*)$", 256)
			result.avrdude_parts = parse_native_choices("/usr/bin/avrdude -p '?'", "^%s+([A-Za-z0-9_-]+)%s+=%s*(.*)$", 512)
		elseif action_id == "firmware.dfu" then
			result.dfu_programmer_targets = parse_native_choices("/usr/bin/dfu-programmer --targets", "^%s+([A-Za-z0-9_-]+)%s*$", 256)
		end
	elseif type(action_id) == "string" and action_id:match("^storage[.]") then
		result.storage_devices = storage_inventory()
	end
	return result
end

local function hardware_snapshot()
	local usb, usb_text = usb_lines()
	local rtl_sdr = rtl_sdr_probe()
	local camera = camera_probe()
	local gps = gps_probe()
	local can = can_probe()
	local android = identity_probe("android")
	local apple_mobile = identity_probe("apple_mobile")
	local programmer = identity_probe("programmer")
	local firmware = firmware_inventories()
	local storage = storage_inventory()
	local serial, serial_summary = serial_attribution()
	local serial_nodes = {}
	for _, device in ipairs(serial) do serial_nodes[#serial_nodes + 1] = device.node end
	local video = list_device_nodes("^video%d+$")
	local i2c = list_device_nodes("^i2c%-%d+$")
	local spi = list_device_nodes("^spidev")
	local can_interfaces = {}
	for _, item in ipairs(can.interfaces) do can_interfaces[#can_interfaces + 1] = item.name end

	local classes = {
		usb = #usb > 0,
		serial = serial_summary.reviewed_general_purpose > 0,
		serial_detected = serial_summary.total > 0,
		cellular_modem = usb_text:match("quectel") ~= nil or usb_text:match("2c7c:") ~= nil,
		video = camera.ready,
		rtl_sdr = rtl_sdr.ready,
		can = can.hardware_present,
		bluetooth = has_dir_entry("/sys/class/bluetooth", "^hci%d+$"),
		i2c = #i2c > 0,
		spi = #spi > 0,
		gps = gps.hardware_present,
		android = android.hardware_present,
		apple_mobile = apple_mobile.hardware_present,
		smartcard = usb_text:match("smart card") ~= nil or usb_text:match("yubico") ~= nil or usb_text:match("yubikey") ~= nil or usb_text:match("ccid") ~= nil,
		programmer = firmware.action_ready,
		usb_storage = #storage > 0
	}

	return {
		usb_devices = usb,
		serial_devices = serial_nodes,
		serial_attribution = serial,
		serial_summary = serial_summary,
		video_devices = video,
		camera = camera,
		gps = gps,
		can = can,
		identity = {
			android = android,
			apple_mobile = apple_mobile,
			programmer = programmer
		},
		firmware = { action_ready = firmware.action_ready, reason = firmware.reason, programmer_count = #firmware.programmer_devices, debug_adapter_count = #firmware.debug_adapter_devices, dfu_count = #firmware.dfu_devices, serial_count = #firmware.serial_devices, connection_count = #firmware.connection_devices },
		storage = { action_ready = #storage > 0, reason = #storage > 0 and string.format("READY - %d NON-SYSTEM USB BLOCK TARGET(S)", #storage) or "READY / NO DEVICE - ACTIVE EXTROOT AND SYSTEM MEDIA ARE EXCLUDED", count = #storage },
		can_interfaces = can_interfaces,
		i2c_devices = i2c,
		spi_devices = spi,
		rtl_sdr = rtl_sdr,
		classes = classes
	}
end

local function ubus_object(command)
	local output = capture(command)
	return parse_json(output) or {}
end

local function first_ipv4(status)
	local addresses = status["ipv4-address"]
	if type(addresses) == "table" and type(addresses[1]) == "table" then
		return addresses[1].address or ""
	end
	return ""
end

local function system_status()
	local board = ubus_object("ubus call system board")
	local memory = meminfo()
	local uptime_body = fs.readfile("/proc/uptime") or "0"
	local uptime = tonumber(uptime_body:match("^(%S+)")) or 0
	local load_body = fs.readfile("/proc/loadavg") or "0 0 0"
	local l1, l5, l15 = load_body:match("^(%S+)%s+(%S+)%s+(%S+)")
	local storage_line = ""
	local storage_output = capture("df -kP /")
	for line in storage_output:gmatch("[^\n]+") do
		if not line:match("^Filesystem") then storage_line = line end
	end
	local _, total_k, used_k, available_k, percent, mountpoint = storage_line:match("^(%S+)%s+(%d+)%s+(%d+)%s+(%d+)%s+(%d+)%%%s+(%S+)")
	local packages = package_inventory()
	local lan = ubus_object("ubus call network.interface.lan status")
	local wan = ubus_object("ubus call network.interface.wan status")
	local dns = {}
	for line in (fs.readfile("/tmp/resolv.conf.d/resolv.conf.auto") or ""):gmatch("[^\n]+") do
		local server = line:match("^nameserver%s+(%S+)")
		if server then dns[#dns + 1] = server end
	end
	local tailscale_installed = binary_exists("tailscale")
	local tailscale_pids = trim(capture("pidof tailscaled"))
	local tailscale_ip = tailscale_installed and trim(capture("tailscale ip -4")) or ""
	local tailscale_version = tailscale_installed and trim((capture("tailscale version")):match("[^\n]+")) or ""
	local swap_total = memory.SwapTotal or 0
	local hardware = hardware_snapshot()

	return {
		generated_at = os.time(),
		system = {
			hostname = trim(fs.readfile("/proc/sys/kernel/hostname")),
			model = board.model or "GL.iNet GL-X750",
			openwrt = release_value("DISTRIB_DESCRIPTION"),
			kernel = trim(capture("uname -r")),
			uptime_seconds = math.floor(uptime),
			load = { tonumber(l1) or 0, tonumber(l5) or 0, tonumber(l15) or 0 },
			memory = {
				total = memory.MemTotal or 0,
				available = memory.MemAvailable or 0,
				free = memory.MemFree or 0
			},
			swap = {
				total = swap_total,
				used = math.max(0, swap_total - (memory.SwapFree or 0)),
				active = swap_total > 0
			},
			storage = {
				total = (tonumber(total_k) or 0) * 1024,
				used = (tonumber(used_k) or 0) * 1024,
				available = (tonumber(available_k) or 0) * 1024,
				percent = tonumber(percent) or 0,
				mountpoint = mountpoint or "/"
			},
			package_count = #packages
		},
		network = {
			lan_ip = first_ipv4(lan),
			wan_interface = wan.l3_device or wan.device or "",
			wan_up = wan.up and true or false,
			wan_ip = first_ipv4(wan),
			default_route = trim((capture("ip route show default")):match("[^\n]+")),
			dns = dns,
			interfaces = interface_list()
		},
		remote_access = {
			tailscale_installed = tailscale_installed,
			tailscale_running = tailscale_pids ~= "",
			tailscale_ip = tailscale_ip,
			tailscale_version = tailscale_version
		},
		hardware = hardware
	}
end

local valid_probe_ids = {
	software = true, usb = true, serial = true, serial_detected = true, cellular_modem = true,
	video = true, rtl_sdr = true, can = true, bluetooth = true,
	i2c = true, spi = true, gps = true, android = true,
	apple_mobile = true, smartcard = true, programmer = true,
	usb_storage = true
}

local function string_array(value)
	if type(value) ~= "table" then return {} end
	local result = {}
	for _, item in ipairs(value) do
		if type(item) == "string" then result[#result + 1] = item end
	end
	return result
end

local phase4_relay_devices

local function load_capabilities()
	local _, package_map = package_inventory()
	local hardware = hardware_snapshot()
	local names = {}
	local iterator = fs.dir(TOOL_ROOT)
	if iterator then
		for name in iterator do
			if name:match("^[a-z0-9][a-z0-9_.%-]+%.json$") then names[#names + 1] = name end
		end
	end
	table.sort(names)

	local modules = {}
	for _, name in ipairs(names) do
		local manifest = parse_json(fs.readfile(TOOL_ROOT .. "/" .. name))
		if type(manifest) == "table" and type(manifest.id) == "string" and
		   manifest.id:match("^[a-z0-9][a-z0-9_.%-]+$") and type(manifest.name) == "string" and
		   type(manifest.category) == "string" then
			local package_names = string_array(manifest.package_names)
			local binaries = string_array(manifest.expected_binaries)
			local required = string_array(manifest.required_hardware)
			local matched_packages = {}
			local matched_binaries = {}
			for _, package_name in ipairs(package_names) do
				if package_map[package_name] then matched_packages[#matched_packages + 1] = package_name end
			end
			for _, binary in ipairs(binaries) do
				if binary_exists(binary) then matched_binaries[#matched_binaries + 1] = binary end
			end
			local software_installed = #matched_packages > 0 or #matched_binaries > 0
			local missing_hardware = {}
			local detected_hardware = {}
			for _, class in ipairs(required) do
				if hardware.classes[class] then
					detected_hardware[#detected_hardware + 1] = class
				else
					missing_hardware[#missing_hardware + 1] = class
				end
			end
			local state
			if not software_installed then
				state = "UNAVAILABLE"
			elseif #missing_hardware > 0 then
				state = manifest.no_device_state == "READY / NO DEVICE" and "READY / NO DEVICE" or "HARDWARE REQUIRED"
			elseif manifest.enabled == true then
				state = "READY"
			else
				state = "NOT CONFIGURED"
			end
			local probe = type(manifest.status_probe) == "string" and manifest.status_probe or "software"
			if not valid_probe_ids[probe] then probe = "software" end
			local action_ready = state == "READY"
			local readiness_reason = state
			if manifest.id == "gps-gnss" and manifest.enabled == true then
				action_ready = hardware.gps.ready
				readiness_reason = hardware.gps.reason
				if software_installed and #missing_hardware == 0 and not action_ready then state = "NOT CONFIGURED" end
			elseif manifest.id == "can" and manifest.enabled == true then
				action_ready = hardware.can.ready
				readiness_reason = hardware.can.reason
				if software_installed and #missing_hardware == 0 and not action_ready then state = "NOT CONFIGURED" end
			elseif manifest.id == "android-repair" and manifest.enabled == true then
				action_ready = hardware.identity.android.action_ready
				readiness_reason = hardware.identity.android.reason
			elseif manifest.id == "apple-repair" and manifest.enabled == true then
				action_ready = hardware.identity.apple_mobile.action_ready
				readiness_reason = hardware.identity.apple_mobile.reason
			elseif manifest.id == "firmware-programming" and manifest.enabled == true then
				action_ready = hardware.firmware.action_ready
				readiness_reason = hardware.firmware.reason
			elseif manifest.id == "storage-recovery" and manifest.enabled == true then
				action_ready = hardware.storage.action_ready
				readiness_reason = hardware.storage.reason
			end
			modules[#modules + 1] = {
				id = manifest.id,
				name = manifest.name,
				category = manifest.category,
				description = manifest.description or "",
				package_names = package_names,
				expected_binaries = binaries,
				required_hardware = required,
				status_probe = probe,
				risk_level = manifest.risk_level or "INFO",
				console_enabled = manifest.enabled == true,
				action_ready = action_ready,
				readiness_reason = readiness_reason,
				mode_counts = manifest.id == "apple-repair" and {
					normal = hardware.identity.apple_mobile.normal_count or 0,
					recovery = hardware.identity.apple_mobile.recovery_count or 0,
					dfu = hardware.identity.apple_mobile.dfu_count or 0
				} or manifest.id == "firmware-programming" and {
					openocd = hardware.firmware.debug_adapter_count or 0,
					avrdude = hardware.firmware.connection_count or 0,
					dfu = hardware.firmware.dfu_count or 0,
					serial_programmer = hardware.firmware.serial_count or 0
				} or manifest.id == "automation" and {
					relay = phase4_relay_devices and #phase4_relay_devices() or 0
				} or nil,
				actions = type(manifest.actions) == "table" and manifest.actions or {},
				help_text = manifest.help_text or "",
				software = {
					installed = software_installed,
					matched_packages = matched_packages,
					matched_binaries = matched_binaries
				},
				hardware = {
					required = #required > 0,
					present = #missing_hardware == 0,
					detected = detected_hardware,
					missing = missing_hardware
				},
				state = state
			}
		end
	end
	return modules
end

