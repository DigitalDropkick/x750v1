{
	"ddk-field-console": {
		"description": "Authenticated access to the allowlisted Digital Dropkick Field Console helper",
		"read": {
			"cgi-io": [ "exec", "download" ],
			"file": {
				"/usr/libexec/ddk-console status": [ "exec" ],
				"/usr/libexec/ddk-console capabilities": [ "exec" ],
				"/usr/libexec/ddk-console packages": [ "exec" ],
				"/usr/libexec/ddk-console info *": [ "exec" ],
				"/usr/libexec/ddk-console action *": [ "exec" ],
				"/usr/libexec/ddk-console upload *": [ "exec" ],
				"/usr/libexec/ddk-console job *": [ "exec" ],
				"/usr/libexec/ddk-console report *": [ "exec" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/snapshot.jpg": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/snapshot.png": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/rtl433.jsonl": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/rtl433.csv": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/rtl433.txt": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/rtl433.cu8": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/serial.bin": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/gnss.raw": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/gnss.decoded": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/android-logcat.txt": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/android-bugreport.txt": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/android-pull.bin": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/android-backup.ab": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/apple-screenshot.tiff": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/apple-syslog.txt": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/apple-restore.log": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/firmware-read.hex": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/firmware-read.bin": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/firmware-dfu-read.bin": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/firmware-serial-read.bin": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/storage-badblocks.txt": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/storage-image.raw": [ "read" ],
				"/overlay/ddk-field-console/artifacts/job-[0-9]*-[0-9]*/recovered-files.tar": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/storage-image.sha256": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/nmap.nmap": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/nmap.xml": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/nmap.gnmap": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/capture.pcap": [ "read" ],
				"/tmp/ddk/jobs/job-[0-9]*-[0-9]*/iperf3.json": [ "read" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/overlay/ddk-field-console/uploads/upload-[0-9]*-[0-9]*-[0-9]*/payload.bin": [ "write" ]
			}
		}
	}
}
