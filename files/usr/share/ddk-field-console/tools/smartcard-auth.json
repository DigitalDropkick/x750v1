{
  "id": "smartcard-auth",
  "name": "Security / Authentication",
  "category": "Security / Authentication",
  "description": "PC/SC and YubiKey operations, OATH tokens, and stoken software tokens.",
  "package_names": ["libfido2-1", "ykpers", "ykclient", "oath-toolkit", "stoken", "pcsc-tools", "pcscd", "ccid"],
  "expected_binaries": ["ykinfo", "ykpersonalize", "oathtool", "stoken", "pcsc_scan"],
