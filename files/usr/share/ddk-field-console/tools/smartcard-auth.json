  "status_probe": "smartcard",
  "risk_level": "SECURITY",
  "enabled": true,
  "actions": [
    {"id": "auth.otp", "label": "OATH token generation", "class": "SECURITY", "execution": "job", "parameter_schema": "operator-v1", "enabled": true},
    {"id": "auth.inventory", "class": "INFO", "execution": "job", "parameter_schema": "operator-v1", "enabled": true},
    {"id": "auth.program", "class": "SECURITY", "execution": "job", "parameter_schema": "operator-v1", "enabled": true},
    {"id": "auth.stoken", "label": "Software token tools", "class": "SECURITY", "execution": "job", "parameter_schema": "operator-v1", "enabled": true}
